@page "/gastos-compartidos"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-shared-view p-3">
    <!-- Encabezado Móvil Limpio -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h5 fw-bold text-slate-900 m-0">Gastos Compartidos</h1>
            <p class="text-muted fs-xs m-0">Cuentas y convivencia en pareja</p>
        </div>
        <div class="d-flex gap-1.5">
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 fs-xs d-flex align-items-center gap-1" @onclick="OpenTransferModal" title="Registrar ajuste o transferencia">
                <Icon Name="repeat" Size="13" />
                <span>Ajuste</span>
            </button>
            <button class="btn btn-sm btn-primary rounded-pill px-2.5 py-1 fs-xs d-flex align-items-center gap-1 shadow-xs" @onclick="OpenAddSharedExpenseModal">
                <Icon Name="plus" Size="13" />
                <span>Gasto</span>
            </button>
        </div>
    </div>

    <!-- TARJETA DESTACADA: BALANCE CON LA PAREJA -->
    @{
        decimal netDebt = AppState.Data.CalculatePartnerDebt();
    }
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm">
        <div class="card-body p-3.5">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
                <span class="fs-xs text-uppercase tracking-wider text-slate-400 fw-bold">Balance de Cuentas</span>
                @if (netDebt > 0)
                {
                    <span class="badge fs-xs rounded-pill" style="background-color: var(--pastel-danger-bg) !important; color: var(--pastel-danger-text) !important; border: 1px solid var(--pastel-danger-border) !important;">
                        Pendiente de pago
                    </span>
                }
                else if (netDebt < 0)
                {
                    <span class="badge fs-xs rounded-pill" style="background-color: var(--pastel-success-bg) !important; color: var(--pastel-success-text) !important; border: 1px solid var(--pastel-success-border) !important;">
                        A tu favor
                    </span>
                }
                else
                {
                    <span class="badge fs-xs rounded-pill bg-secondary-subtle text-secondary border">
                        Al día
                    </span>
                }
            </div>

            <div class="d-flex align-items-baseline justify-content-between my-1">
                <div class="financial-display-amount fw-bold tracking-tight text-white">
                    @if (netDebt > 0)
                    {
                        <span>Debes @netDebt.ToString("N2") €</span>
                    }
                    else if (netDebt < 0)
                    {
                        <span>Te deben @(Math.Abs(netDebt).ToString("N2")) €</span>
                    }
                    else
                    {
                        <span>0,00 €</span>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2.5 pt-2 border-top border-slate-700">
                <span class="fs-xs text-slate-400">
                    @(netDebt == 0 ? "No hay diferencias pendientes." : "Saldo acumulado automáticamente.")
                </span>
                @if (netDebt > 0)
                {
                    <button class="btn btn-light btn-xs rounded-pill px-3 py-1 font-medium fs-xs shadow-xs" @onclick="() => QuickPayPartner(netDebt)">
                        Saldar deuda
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- MÉTRICAS CLAVE (3 columnas limpias) -->
    <div class="row g-2 mb-3">
        <div class="col-4">
            <div class="card p-2 bg-white rounded-3 h-100">
                <span class="fs-xs text-muted fw-semibold text-truncate d-block">Total Común</span>
                <div class="fw-bold text-dark fs-6 mt-0.5">
                    @SharedExpenses.Sum(e => e.Amount).ToString("N0") €
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card p-2 bg-white rounded-3 h-100">
                <span class="fs-xs text-muted fw-semibold text-truncate d-block">Tu Parte</span>
                <div class="fw-bold text-dark fs-6 mt-0.5">
                    @SharedExpenses.Sum(e => e.UserShareAmount).ToString("N0") €
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card p-2 bg-white rounded-3 h-100">
                <span class="fs-xs text-muted fw-semibold text-truncate d-block">Pagaste Tú</span>
                <div class="fw-bold text-dark fs-6 mt-0.5">
                    @SharedExpenses.Where(e => e.PaidBy == "Yo").Sum(e => e.Amount).ToString("N0") €
                </div>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS: GASTOS COMUNES vs HISTORIAL DE AJUSTES -->
    <div class="segmented-control mb-3">
        <button type="button" class="segmented-item @(activeTab == "gastos" ? "active" : "")" @onclick='() => activeTab = "gastos"'>
            Gastos Comunes (@SharedExpenses.Count())
        </button>
        <button type="button" class="segmented-item @(activeTab == "ajustes" ? "active" : "")" @onclick='() => activeTab = "ajustes"'>
            Ajustes Realizados (@AppState.Data.PartnerPayments.Count)
        </button>
    </div>

    <!-- CONTENIDO SEGÚN PESTAÑA -->
    @if (activeTab == "gastos")
    {
        @if (!SharedExpenses.Any())
        {
            <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
                <Icon Name="receipt" Size="28" Class="text-muted opacity-50 mb-2" />
                <div class="fw-bold text-slate-800 small">Sin gastos compartidos</div>
                <p class="text-muted fs-xs mb-3">Registra compras de supermercado, vivienda o cenas compartidas.</p>
                <div>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenAddSharedExpenseModal">
                        + Registrar primer gasto
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
                <div class="divide-y">
                    @foreach (var exp in SharedExpenses.OrderByDescending(e => e.Date))
                    {
                        <div class="p-3 border-bottom border-slate-100 hover-bg-light transition">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="category-icon-bubble">
                                        @GetCategoryIcon(exp.Category)
                                    </div>
                                    <div>
                                        <div class="fw-bold text-slate-900 small">@exp.Concept</div>
                                        <div class="d-flex align-items-center gap-1.5 mt-0.5">
                                            <span class="badge bg-light text-secondary border fs-xs">@exp.Category</span>
                                            <span class="text-muted fs-xs">@exp.Date.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-slate-900 fs-6">@exp.Amount.ToString("N2") €</div>
                                    <div class="fs-xs text-muted">Total</div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-slate-50 fs-xs">
                                <div>
                                    @if (exp.PaidBy == "Yo")
                                    {
                                        <span class="badge rounded-pill" style="background-color: var(--pastel-success-bg); color: var(--pastel-success-text); border: 1px solid var(--pastel-success-border);">
                                            Pagaste tú
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill" style="background-color: var(--pastel-info-bg); color: var(--pastel-info-text); border: 1px solid var(--pastel-info-border);">
                                            Pagó pareja
                                        </span>
                                    }
                                </div>
                                <div class="text-muted">
                                    Tu parte: <strong class="text-slate-900">@exp.UserShareAmount.ToString("N2") €</strong> (@exp.SharedPercentageUser.ToString("N0")%)
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        @if (!AppState.Data.PartnerPayments.Any())
        {
            <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
                <Icon Name="repeat" Size="28" Class="text-muted opacity-50 mb-2" />
                <div class="fw-bold text-slate-800 small">Sin transferencias registradas</div>
                <p class="text-muted fs-xs mb-3">Las transferencias entre vosotros para regularizar saldos aparecerán aquí.</p>
                <div>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="OpenTransferModal">
                        + Registrar transferencia
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
                <div class="divide-y">
                    @foreach (var payment in AppState.Data.PartnerPayments.OrderByDescending(p => p.Date))
                    {
                        <div class="p-3 border-bottom border-slate-100 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="category-icon-bubble bg-light">
                                    <Icon Name="repeat" Size="14" Class="text-secondary" />
                                </div>
                                <div>
                                    <div class="fw-bold text-slate-900 small">@payment.Concept</div>
                                    <div class="text-muted fs-xs">
                                        @payment.Date.ToString("dd/MM/yyyy") • @(payment.FromWhom == "Yo" ? "Pagaste a tu pareja" : "Recibiste de tu pareja")
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold fs-6 @(payment.FromWhom == "Yo" ? "text-slate-900" : "text-emerald-600")">
                                    @(payment.FromWhom == "Yo" ? "-" : "+")@payment.Amount.ToString("N2") €
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- MODAL GASTO COMPARTIDO -->
<ModalDialog IsOpen="isExpenseModalOpen" Title="Registrar Gasto Compartido" OnClose="() => isExpenseModalOpen = false">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Concepto</label>
                <input type="text" class="form-control" @bind="newSharedExpense.Concept" placeholder="Ej. Compra Mercadona, Alquiler, Cena..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Importe (€)</label>
                <input type="number" step="0.01" class="form-control" @bind="newSharedExpense.Amount" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Fecha</label>
                <input type="date" class="form-control" @bind="newSharedExpense.Date" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Categoría</label>
                <select class="form-select" @bind="newSharedExpense.Category">
                    <option value="Alimentación">Alimentación</option>
                    <option value="Vivienda">Vivienda</option>
                    <option value="Ocio">Ocio</option>
                    <option value="Transporte">Transporte</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">¿Quién pagó?</label>
                <select class="form-select" @bind="newSharedExpense.PaidBy">
                    <option value="Yo">Pagué Yo</option>
                    <option value="Pareja">Pagó mi Pareja</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Tu porcentaje (%)</label>
                <input type="number" class="form-control" @bind="newSharedExpense.SharedPercentageUser" min="0" max="100" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="() => isExpenseModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveSharedExpense">Guardar Gasto</button>
    </Footer>
</ModalDialog>

<!-- MODAL TRANSFERENCIA / AJUSTE CON PAREJA -->
<ModalDialog IsOpen="isTransferModalOpen" Title="Registrar Ajuste con Pareja" OnClose="() => isTransferModalOpen = false">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Concepto</label>
                <input type="text" class="form-control" @bind="transferConcept" placeholder="Ej. Bizum liquidación, Transferencia..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Importe (€)</label>
                <input type="number" step="0.01" class="form-control" @bind="transferAmount" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Sentido del Pago</label>
                <select class="form-select" @bind="transferFrom">
                    <option value="Yo">Yo pagué a mi pareja</option>
                    <option value="Pareja">Mi pareja me pagó a mí</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Fecha</label>
                <input type="date" class="form-control" @bind="transferDate" />
            </div>
            <div class="col-12 text-muted fs-xs">
                Este movimiento saldará el balance pendiente con tu pareja y actualizará tu contabilidad.
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="() => isTransferModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveTransfer">Guardar Ajuste</button>
    </Footer>
</ModalDialog>

@code {
    private string activeTab = "gastos";
    private bool isExpenseModalOpen = false;
    private Expense newSharedExpense = new() { Scope = ExpenseScope.Compartido };

    private bool isTransferModalOpen = false;
    private string transferConcept = "Transferencia a pareja";
    private decimal transferAmount = 0;
    private string transferFrom = "Yo";
    private DateTime transferDate = DateTime.Today;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private IEnumerable<Expense> SharedExpenses => AppState.Data.Expenses.Where(e => e.Scope == ExpenseScope.Compartido);

    private string GetCategoryIcon(string category) => category switch
    {
        "Vivienda" => "🏠",
        "Alimentación" => "🛒",
        "Ocio" => "☕",
        "Transporte" => "🚗",
        _ => "📦"
    };

    private void OpenAddSharedExpenseModal()
    {
        newSharedExpense = new Expense 
        { 
            Date = DateTime.Today,
            Scope = ExpenseScope.Compartido,
            SharedPercentageUser = 50m,
            PaidBy = "Yo",
            Category = "Alimentación"
        };
        isExpenseModalOpen = true;
    }

    private async Task SaveSharedExpense()
    {
        if (string.IsNullOrWhiteSpace(newSharedExpense.Concept) || newSharedExpense.Amount <= 0) return;
        newSharedExpense.Scope = ExpenseScope.Compartido;
        await AppState.AddExpenseAsync(newSharedExpense);
        isExpenseModalOpen = false;
    }

    private void OpenTransferModal()
    {
        decimal debt = AppState.Data.CalculatePartnerDebt();
        transferAmount = debt > 0 ? debt : 0;
        transferConcept = $"Ajuste cuentas {DateTime.Today:MMMM}";
        transferFrom = "Yo";
        transferDate = DateTime.Today;
        isTransferModalOpen = true;
    }

    private void QuickPayPartner(decimal amount)
    {
        transferAmount = amount;
        transferConcept = "Regularización total de saldo con pareja";
        transferFrom = "Yo";
        transferDate = DateTime.Today;
        isTransferModalOpen = true;
    }

    private async Task SaveTransfer()
    {
        if (transferAmount <= 0) return;
        await AppState.AddPartnerPaymentAsync(transferAmount, transferConcept, transferFrom);
        isTransferModalOpen = false;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
