@page "/fondos-familia"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-family-view p-3">
    <!-- Encabezado Móvil Limpio -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h5 fw-bold text-slate-900 m-0">Familia & Terceros</h1>
            <p class="text-muted fs-xs m-0">Préstamo de padres y multidivisa (USD/ARS)</p>
        </div>
        <div class="d-flex gap-1.5">
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 fs-xs d-flex align-items-center gap-1" @onclick="OpenRepaymentModal">
                <Icon Name="arrow-up-right" Size="13" />
                <span>Devolver</span>
            </button>
            <button class="btn btn-sm btn-primary rounded-pill px-2.5 py-1 fs-xs d-flex align-items-center gap-1 shadow-xs" @onclick="OpenFamilyItemModal">
                <Icon Name="plus" Size="13" />
                <span>Nuevo</span>
            </button>
        </div>
    </div>

    <!-- TARJETA HERO: PRÉSTAMO DE LOS PADRES -->
    @{
        var loan = AppState.Data.FamilyLoan;
    }
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm">
        <div class="card-body p-3.5">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
                <span class="fs-xs text-uppercase tracking-wider text-slate-400 fw-bold">Préstamo Familiar Padres</span>
                <span class="badge fs-xs rounded-pill" style="@(loan.PendingTotal > 0 ? "background-color: var(--pastel-danger-bg); color: var(--pastel-danger-text); border: 1px solid var(--pastel-danger-border);" : "background-color: var(--pastel-success-bg); color: var(--pastel-success-text); border: 1px solid var(--pastel-success-border);")">
                    @(loan.PendingTotal > 0 ? $"{loan.ProgressPercentage}% amortizado" : "Liquidado")
                </span>
            </div>

            <div class="d-flex align-items-baseline justify-content-between my-1">
                <div class="financial-display-amount fw-bold tracking-tight text-white">
                    @loan.PendingTotal.ToString("N2") € <span class="fs-6 fw-normal text-slate-300">por devolver</span>
                </div>
            </div>

            <!-- Barra de amortización -->
            <div class="my-2">
                <div class="progress" style="height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.15);">
                    <div class="progress-bar bg-light" role="progressbar" style="width: @loan.ProgressPercentage%;"></div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2.5 pt-2 border-top border-slate-700 fs-xs">
                <span class="text-slate-400">
                    Inicial: <strong class="text-slate-300">@loan.InitialAmount.ToString("N0") €</strong>
                </span>
                <span class="text-slate-400">
                    Devuelto: <strong class="text-emerald-400">@loan.RepaidTotal.ToString("N0") €</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS: ENCARGOS MULTIDIVISA vs PRÉSTAMO PADRES -->
    <div class="segmented-control mb-3">
        <button type="button" class="segmented-item @(activeTab == "encargos" ? "active" : "")" @onclick='() => activeTab = "encargos"'>
            Encargos & Divisas (@AppState.Data.FamilyFundItems.Count)
        </button>
        <button type="button" class="segmented-item @(activeTab == "devoluciones" ? "active" : "")" @onclick='() => activeTab = "devoluciones"'>
            Pagos a Padres (@loan.Repayments.Count)
        </button>
    </div>

    @if (activeTab == "encargos")
    {
        @if (!AppState.Data.FamilyFundItems.Any())
        {
            <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
                <Icon Name="users" Size="28" Class="text-muted opacity-50 mb-2" />
                <div class="fw-bold text-slate-800 small">Sin encargos familiares</div>
                <p class="text-muted fs-xs mb-3">Registra dinero recibido de familiares en USD/ARS para compras o encargos.</p>
                <div>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenFamilyItemModal">
                        + Registrar movimiento
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2.5 mb-4">
                @foreach (var item in AppState.Data.FamilyFundItems)
                {
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white @(item.IsSettled ? "opacity-60" : "")">
                        <div class="p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="category-icon-bubble">
                                        👤
                                    </div>
                                    <div>
                                        <div class="fw-bold text-slate-900 small">@item.Person</div>
                                        <div class="text-muted fs-xs">@item.Purpose</div>
                                    </div>
                                </div>
                                <span class="badge rounded-pill fs-xs" style="@(item.Direction == DirectionType.RecibidoParaAdministrar ? "background-color: var(--pastel-info-bg); color: var(--pastel-info-text); border: 1px solid var(--pastel-info-border);" : "background-color: var(--pastel-success-bg); color: var(--pastel-success-text); border: 1px solid var(--pastel-success-border);")">
                                    @(item.Direction == DirectionType.RecibidoParaAdministrar ? "A administrar" : "Adelantado por ti")
                                </span>
                            </div>

                            <div class="row g-2 my-2 py-2 border-top border-bottom border-slate-100 fs-xs">
                                <div class="col-6">
                                    <span class="text-muted d-block">Divisa Original</span>
                                    <strong class="text-slate-900 fs-6">@item.OriginalAmount.ToString("N0") @item.OriginalCurrency</strong>
                                    <div class="text-muted fs-xs">1 @item.OriginalCurrency = @item.ExchangeRate.ToString("0.00##") €</div>
                                </div>
                                <div class="col-6 text-end">
                                    <span class="text-muted d-block">Saldo Restante</span>
                                    <strong class="fs-6 @(item.Direction == DirectionType.AdelantadoPorMi ? "text-emerald-700" : "text-danger")">
                                        @item.RemainingEur.ToString("N2") €
                                    </strong>
                                    <div class="text-muted fs-xs">de @item.EurEquivalent.ToString("N0") €</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 fs-xs d-flex align-items-center gap-1"
                                        @onclick="() => DeleteFamilyItem(item.Id)">
                                    <Icon Name="trash" Size="13" />
                                    <span>Eliminar</span>
                                </button>
                                <div class="d-flex gap-1.5">
                                    @if (!item.IsSettled && item.RemainingEur > 0)
                                    {
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 fs-xs" @onclick="() => OpenRecordExpenseModal(item)">
                                            - Gasto
                                        </button>
                                        <button class="btn btn-sm btn-dark rounded-pill px-2.5 py-1 fs-xs shadow-xs" @onclick="() => SettleItem(item.Id)">
                                            Liquidar
                                        </button>
                                    }
                                    else if (item.IsSettled)
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1 fs-xs">Saldado</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- HISTORIAL DE AMORTIZACIONES A PADRES -->
        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
            <span class="fs-xs fw-bold text-muted text-uppercase tracking-wider">Historial de Devoluciones</span>
            <button class="btn btn-xs btn-outline-secondary rounded-pill px-2.5 py-1 fs-xs" @onclick="OpenRepaymentModal">
                + Amortizar
            </button>
        </div>

        @if (!loan.Repayments.Any())
        {
            <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
                <Icon Name="repeat" Size="28" Class="text-muted opacity-50 mb-2" />
                <div class="fw-bold text-slate-800 small">Sin amortizaciones registradas</div>
                <p class="text-muted fs-xs mb-3">Registra los pagos realizados a tus padres para reducir la deuda.</p>
                <div>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenRepaymentModal">
                        + Registrar primer pago
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
                <div class="divide-y">
                    @foreach (var rep in loan.Repayments.OrderByDescending(r => r.Date))
                    {
                        <div class="p-3 border-bottom border-slate-100 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="category-icon-bubble bg-light">
                                    🤝
                                </div>
                                <div>
                                    <div class="fw-bold text-slate-900 small">@rep.Note</div>
                                    <div class="text-muted fs-xs">@rep.Date.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                            <span class="fw-bold text-slate-900 fs-6">
                                -@rep.Amount.ToString("N2") €
                            </span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- MODAL DEVOLUCIÓN A PADRES -->
<ModalDialog IsOpen="isRepaymentModalOpen" Title="Amortizar Préstamo Padres" OnClose="() => isRepaymentModalOpen = false">
    <ChildContent>
        <div class="p-2.5 bg-light rounded-2 mb-3 fs-xs">
            <span>Saldo pendiente actual: <strong class="text-slate-900">@AppState.Data.FamilyLoan.PendingTotal.ToString("N2") €</strong></span>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Importe a Devolver (€)</label>
                <input type="number" step="10" class="form-control" @bind="repaymentAmount" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Concepto / Nota</label>
                <input type="text" class="form-control" @bind="repaymentNote" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="() => isRepaymentModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveRepayment">Confirmar Devolución</button>
    </Footer>
</ModalDialog>

<!-- MODAL NUEVO MOVIMIENTO FAMILIA -->
<ModalDialog IsOpen="isFamilyItemModalOpen" Title="Nuevo Encargo Familiar" OnClose="() => isFamilyItemModalOpen = false">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Familiar / Persona</label>
                <input type="text" class="form-control" @bind="newFamilyItem.Person" placeholder="Ej. Mamá, Papá, Hermano..." />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Tipo de Operación</label>
                <select class="form-select" @bind="newFamilyItem.Direction">
                    <option value="@DirectionType.RecibidoParaAdministrar">Dinero recibido para administrar</option>
                    <option value="@DirectionType.AdelantadoPorMi">Adelantado por mí (a devolver)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Moneda Original</label>
                <select class="form-select" @bind="newFamilyItem.OriginalCurrency" @bind:after="OnCurrencyChanged">
                    <option value="@CurrencyType.USD">USD ($)</option>
                    <option value="@CurrencyType.EUR">EUR (€)</option>
                    <option value="@CurrencyType.ARS">ARS ($)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Importe Original</label>
                <input type="number" step="0.01" class="form-control" @bind="newFamilyItem.OriginalAmount" />
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Tipo Cambio (1 Divisa = X EUR)</label>
                <input type="number" step="0.0001" class="form-control" @bind="newFamilyItem.ExchangeRate" />
            </div>
            <div class="col-12">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Finalidad / Concepto</label>
                <input type="text" class="form-control" @bind="newFamilyItem.Purpose" placeholder="Ej. Compra encargada, billete avión..." />
            </div>
            <div class="col-12 bg-light p-2.5 rounded-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted fs-xs">Equivalente consolidado en euros:</span>
                    <strong class="text-slate-900 fs-6">@newFamilyItem.EurEquivalent.ToString("N2") €</strong>
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="() => isFamilyItemModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveFamilyItem">Guardar Movimiento</button>
    </Footer>
</ModalDialog>

<!-- MODAL REGISTRAR GASTO DE UN FONDO -->
<ModalDialog IsOpen="isSpendModalOpen" Title="Registrar Gasto de este Fondo" OnClose="() => isSpendModalOpen = false">
    <ChildContent>
        @if (selectedItemForSpend != null)
        {
            <div class="p-2.5 bg-light rounded-2 mb-3 fs-xs">
                <span>Fondo de <strong class="text-slate-900">@selectedItemForSpend.Person</strong> • Saldo disponible: <strong class="text-emerald-700">@selectedItemForSpend.RemainingEur.ToString("N2") €</strong></span>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Importe Gastado (€)</label>
                    <input type="number" step="0.01" class="form-control" @bind="spendAmount" max="@selectedItemForSpend.RemainingEur" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Fecha</label>
                    <input type="date" class="form-control" @bind="spendDate" />
                </div>
                <div class="col-12">
                    <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Concepto del Gasto</label>
                    <input type="text" class="form-control" @bind="spendConcept" placeholder="Ej. Compra en El Corte Inglés encargada..." />
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="() => isSpendModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveSpend">Registrar Gasto</button>
    </Footer>
</ModalDialog>

@code {
    private string activeTab = "encargos";
    private bool isRepaymentModalOpen = false;
    private decimal repaymentAmount = 500m;
    private string repaymentNote = "Amortización mensual préstamo";

    private bool isFamilyItemModalOpen = false;
    private FamilyFundItem newFamilyItem = new();

    private bool isSpendModalOpen = false;
    private FamilyFundItem? selectedItemForSpend;
    private decimal spendAmount = 0;
    private string spendConcept = "";
    private DateTime spendDate = DateTime.Today;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private void OpenRepaymentModal()
    {
        repaymentAmount = Math.Min(500m, AppState.Data.FamilyLoan.PendingTotal);
        repaymentNote = $"Amortización {DateTime.Today:MMMM yyyy}";
        isRepaymentModalOpen = true;
    }

    private async Task SaveRepayment()
    {
        if (repaymentAmount <= 0) return;
        await AppState.AddFamilyLoanRepaymentAsync(repaymentAmount, repaymentNote);
        isRepaymentModalOpen = false;
    }

    private void OpenFamilyItemModal()
    {
        newFamilyItem = new FamilyFundItem
        {
            Person = "",
            Direction = DirectionType.RecibidoParaAdministrar,
            OriginalCurrency = CurrencyType.USD,
            OriginalAmount = 1000m,
            ExchangeRate = 0.92m,
            ExchangeRateDate = DateTime.Today,
            Purpose = ""
        };
        isFamilyItemModalOpen = true;
    }

    private void OnCurrencyChanged()
    {
        newFamilyItem.ExchangeRate = newFamilyItem.OriginalCurrency switch
        {
            CurrencyType.USD => 0.92m,
            CurrencyType.ARS => 0.00075m,
            CurrencyType.EUR => 1.0m,
            _ => 1.0m
        };
    }

    private async Task SaveFamilyItem()
    {
        if (string.IsNullOrWhiteSpace(newFamilyItem.Person) || newFamilyItem.OriginalAmount <= 0) return;
        newFamilyItem.ExchangeRateDate = DateTime.Today;
        await AppState.AddFamilyFundItemAsync(newFamilyItem);
        isFamilyItemModalOpen = false;
    }

    private void OpenRecordExpenseModal(FamilyFundItem item)
    {
        selectedItemForSpend = item;
        spendAmount = 0;
        spendConcept = "";
        spendDate = DateTime.Today;
        isSpendModalOpen = true;
    }

    private async Task SaveSpend()
    {
        if (selectedItemForSpend != null && spendAmount > 0)
        {
            await AppState.RecordFamilyExpenseAsync(selectedItemForSpend.Id, spendAmount, spendConcept);
            isSpendModalOpen = false;
        }
    }

    private async Task SettleItem(string id)
    {
        await AppState.SettleFamilyItemAsync(id);
    }

    private async Task DeleteFamilyItem(string id)
    {
        await AppState.DeleteFamilyFundItemAsync(id);
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
