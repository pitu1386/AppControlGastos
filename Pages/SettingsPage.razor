@page "/configuracion"
@inject AppStateService AppState
@implements IDisposable

<div class="settings-container p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="h5 fw-bold text-slate-900 m-0">Ajustes & Respaldo de Datos</h1>
            <p class="text-muted fs-xs m-0 mt-1">
                Configura tu saldo bancario, sincroniza con Supabase y gestiona tus copias de seguridad.
            </p>
        </div>
    </div>

    <!-- SALDO BANCARIO INMEDIATO -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white border-bottom py-2 px-3 py-sm-3 px-sm-4">
            <h2 class="h6 fw-bold m-0 text-slate-900">Saldo Actual en Cuenta Bancaria</h2>
        </div>
        <div class="card-body p-3 p-sm-4">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-7">
                    <label class="form-label small fw-semibold">Saldo total reflejado en tu banco (€)</label>
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <input type="number" step="10" class="form-control form-control-md fw-bold fs-5" @bind="bankBalance" />
                        <button class="btn btn-primary px-3 py-2 fw-semibold text-nowrap" style="min-height: 44px;" @onclick="UpdateBankBalance">
                            Actualizar Saldo
                        </button>
                    </div>
                    <small class="text-muted d-block mt-1 fs-xs">
                        Este es el saldo antes de aplicar reservas fiscales y compromisos.
                    </small>
                </div>
                <div class="col-12 col-md-5 text-md-end">
                    <div class="p-2 p-sm-3 bg-light rounded-3 d-inline-block text-start w-100">
                        <span class="fs-xs text-muted d-block">Disponible Real resultante:</span>
                        <span class="fs-4 fw-bold @(AppState.Data.RealAvailableCash >= 0 ? "text-success" : "text-danger")">
                            @AppState.Data.RealAvailableCash.ToString("N2") €
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- COPIAS DE SEGURIDAD Y RESTAURACIÓN -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <h2 class="h6 fw-bold m-0 text-slate-900">Copias de Seguridad (Backup JSON)</h2>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <h3 class="h6 fw-bold text-dark">Descargar Copia de Seguridad</h3>
                    <p class="small text-muted">
                        Descarga un archivo <code>.json</code> completo con todas tus facturas, gastos, cuotas, proyectos, deudas y fondos. Puedes guardarlo en tu ordenador o nube.
                    </p>
                    <button class="btn btn-outline-primary rounded-pill px-4 d-flex align-items-center gap-2" @onclick="ExportBackup">
                        <Icon Name="download" Size="16" />
                        <span>Exportar Backup JSON</span>
                    </button>
                </div>

                <div class="col-12 col-md-6 border-start-md">
                    <h3 class="h6 fw-bold text-dark">Restaurar Copia de Seguridad</h3>
                    <p class="small text-muted">
                        Selecciona un archivo JSON previamente exportado para recuperar toda tu información contable al instante.
                    </p>
                    <div class="mb-3">
                        <InputFile OnChange="HandleFileSelected" class="form-control form-control-sm" accept=".json" />
                    </div>
                    @if (!string.IsNullOrEmpty(restoreMessage))
                    {
                        <div class="alert alert-info small py-2">@restoreMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- DATOS DE DEMOSTRACIÓN Y REINICIO -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <h2 class="h6 fw-bold m-0 text-slate-900">Gestión de Datos</h2>
        </div>
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h3 class="h6 fw-bold text-dark m-0">Cargar Datos de Demostración Realistas</h3>
                    <small class="text-muted">
                        Rellena el programa con los datos de ejemplo (clientes de Bélgica a 90 días, autónomos 320€, gestoría 90€, cuotas de Argentina, préstamo familiar, mamá 500 USD).
                    </small>
                </div>
                <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="LoadDemo">
                    Recargar Datos de Ejemplo
                </button>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h3 class="h6 fw-bold text-danger m-0">Vaciar Todos los Datos</h3>
                    <small class="text-muted">
                        Borra todas las transacciones para comenzar tu contabilidad completamente limpia desde cero.
                    </small>
                </div>
                <button class="btn btn-outline-danger rounded-pill px-4" @onclick="ClearAll">
                    Empezar en Blanco
                </button>
            </div>
        </div>
    </div>

    <!-- SINCRONIZACIÓN EN LA NUBE (SUPABASE) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">☁️</span>
                <h2 class="h6 fw-bold m-0 text-slate-900">Sincronización Supabase (Nube)</h2>
            </div>
            <span class="badge @(Sync.State == SyncState.Synced ? "bg-success" : (Sync.State == SyncState.Syncing ? "bg-warning text-dark" : (Sync.State == SyncState.Error ? "bg-danger" : "bg-secondary")))">
                @(Sync.State == SyncState.Synced ? "🟢 Nube conectada" : (Sync.State == SyncState.Syncing ? "🔄 Sincronizando..." : (Sync.State == SyncState.Error ? "🔴 Error" : "⚪ Solo Local")))
            </span>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-light border small mb-3">
                <div class="fw-bold mb-1">🔗 Proyecto Supabase Compartido:</div>
                <div class="text-muted font-monospace mb-2">@AppInfo.SupabaseUrl</div>
                <div class="d-flex align-items-center gap-2 text-success">
                    <Icon Name="shield" Size="14" />
                    <span><strong>Seguridad garantizada:</strong> Esta aplicación solo utiliza las tablas con prefijo <code>gastos_*</code>. Tus tablas de <em>AppCobros</em> (<code>clientes</code>, <code>config</code>, <code>grupos</code>, <code>movimientos</code>, <code>papelera</code>) quedan 100% intactas y sin tocar.</span>
                </div>
            </div>

            <!-- Login opcional con la misma cuenta de Supabase -->
            <div class="p-3 bg-light rounded-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold">Cuenta de Usuario Supabase:</span>
                    @if (Auth.IsSignedIn)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            Sesión activa: @Auth.Email
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border">Modo anónimo / Sin iniciar sesión</span>
                    }
                </div>
                @if (Auth.IsSignedIn)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">Conectado como <strong>@Auth.Email</strong></small>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="HandleLogout">Cerrar Sesión</button>
                    </div>
                }
                else
                {
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-5">
                            <input type="email" placeholder="Email de Supabase" class="form-control form-control-sm" @bind="loginEmail" />
                        </div>
                        <div class="col-12 col-md-4">
                            <input type="password" placeholder="Contraseña" class="form-control form-control-sm" @bind="loginPassword" />
                        </div>
                        <div class="col-12 col-md-3">
                            <button class="btn btn-dark btn-sm w-100" @onclick="HandleLogin" disabled="@isLoggingIn">
                                @(isLoggingIn ? "Entrando..." : "Iniciar Sesión")
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(loginMessage))
                    {
                        <small class="text-info d-block mt-2">@loginMessage</small>
                    }
                }
            </div>

            <!-- Acciones de sincronización -->
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <button class="btn btn-outline-primary w-100 rounded-pill py-2 d-flex align-items-center justify-content-center gap-2" @onclick="TestCloudConnection">
                        <span>📡 Probar Conexión</span>
                    </button>
                </div>
                <div class="col-12 col-md-4">
                    <button class="btn btn-primary w-100 rounded-pill py-2 d-flex align-items-center justify-content-center gap-2" @onclick="SyncPushToCloud">
                        <Icon Name="upload" Size="16" />
                        <span>Subir Datos a la Nube</span>
                    </button>
                </div>
                <div class="col-12 col-md-4">
                    <button class="btn btn-outline-success w-100 rounded-pill py-2 d-flex align-items-center justify-content-center gap-2" @onclick="SyncPullFromCloud">
                        <Icon Name="download" Size="16" />
                        <span>Descargar de la Nube</span>
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(cloudStatusMessage))
            {
                <div class="alert @(cloudStatusIsSuccess ? "alert-success" : "alert-warning") small py-2 mt-3 mb-0">
                    @cloudStatusMessage
                </div>
            }

            @if (Sync.LastSyncTime.HasValue)
            {
                <div class="text-muted small text-center mt-2">
                    Última sincronización: @Sync.LastSyncTime.Value.ToString("g")
                </div>
            }
        </div>
    </div>

    <!-- PWA STATUS -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3">
                <Icon Name="shield" Size="32" Class="text-success" />
                <div>
                    <h3 class="h6 fw-bold text-dark m-0">PWA Móvil Instalable & 100% Offline-First</h3>
                    <small class="text-muted">
                        Esta aplicación funciona de forma inmediata sin esperas. Todos los datos se guardan en el almacenamiento local de tu dispositivo y se sincronizan con Supabase cuando lo desees para ver lo mismo en tu PC y en tu móvil.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private SupabaseSyncService Sync { get; set; } = default!;
    [Inject] private SupabaseAuthService Auth { get; set; } = default!;

    private decimal bankBalance;
    private string restoreMessage = "";
    private string cloudStatusMessage = "";
    private bool cloudStatusIsSuccess = true;
    private string loginEmail = "";
    private string loginPassword = "";
    private string loginMessage = "";
    private bool isLoggingIn = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
        Sync.OnSyncStatusChanged += StateHasChanged;
        Auth.OnSessionChanged += StateHasChanged;
        bankBalance = AppState.Data.BankAccountBalance;
    }

    private async Task UpdateBankBalance()
    {
        await AppState.SetBankAccountBalanceAsync(bankBalance);
    }

    private async Task ExportBackup()
    {
        await AppState.DownloadBackupAsync();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var reader = new System.IO.StreamReader(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                var content = await reader.ReadToEndAsync();
                bool ok = await AppState.RestoreBackupAsync(content);
                restoreMessage = ok ? "✅ Copia de seguridad restaurada correctamente." : "❌ Error al leer el archivo JSON.";
                bankBalance = AppState.Data.BankAccountBalance;
            }
        }
        catch (Exception ex)
        {
            restoreMessage = $"❌ Error: {ex.Message}";
        }
    }

    private void LoadDemo()
    {
        AppState.LoadDemoData(saveImmediately: true);
        bankBalance = AppState.Data.BankAccountBalance;
    }

    private async Task ClearAll()
    {
        await AppState.ResetAllDataAsync();
        bankBalance = 0;
    }

    private async Task TestCloudConnection()
    {
        cloudStatusMessage = "Comprobando conexión con Supabase...";
        var (ok, msg) = await Sync.TestConnectionAsync();
        cloudStatusIsSuccess = ok;
        cloudStatusMessage = ok ? "✅ " + msg : "⚠️ " + msg;
    }

    private async Task SyncPushToCloud()
    {
        cloudStatusMessage = "Guardando datos en la nube...";
        var (ok, msg) = await Sync.PushToCloudAsync(AppState.Data);
        cloudStatusIsSuccess = ok;
        cloudStatusMessage = ok ? "✅ " + msg : "❌ " + msg;
    }

    private async Task SyncPullFromCloud()
    {
        cloudStatusMessage = "Descargando datos desde la nube...";
        var (ok, loaded, msg) = await Sync.PullFromCloudAsync();
        cloudStatusIsSuccess = ok;
        if (ok && loaded != null)
        {
            await AppState.SetFullDataAsync(loaded);
            bankBalance = AppState.Data.BankAccountBalance;
            cloudStatusMessage = "✅ Datos actualizados desde la nube.";
        }
        else
        {
            cloudStatusMessage = (ok ? "ℹ️ " : "❌ ") + msg;
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginEmail) || string.IsNullOrWhiteSpace(loginPassword))
        {
            loginMessage = "Ingresa tu email y contraseña de Supabase.";
            return;
        }

        isLoggingIn = true;
        loginMessage = "Conectando...";
        var (ok, err) = await Auth.SignInWithPasswordAsync(loginEmail, loginPassword);
        isLoggingIn = false;
        if (ok)
        {
            loginMessage = "✅ Sesión iniciada con éxito.";
            loginPassword = "";
            await SyncPullFromCloud();
        }
        else
        {
            loginMessage = $"❌ {err}";
        }
    }

    private async Task HandleLogout()
    {
        await Auth.SignOutAsync();
        loginMessage = "Sesión cerrada.";
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        Sync.OnSyncStatusChanged -= StateHasChanged;
        Auth.OnSessionChanged -= StateHasChanged;
    }
}

