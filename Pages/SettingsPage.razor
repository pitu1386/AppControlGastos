@page "/configuracion"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-settings-view p-3">
    <!-- CABECERA MÓVIL IMPECCABLE -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">⚙️</span>
                <h1 class="h5 fw-bold text-slate-900 m-0">Ajustes & Respaldo</h1>
            </div>
            <p class="fs-xs text-muted m-0 mt-1">
                Saldo bancario, sincronización en la nube y copias de datos.
            </p>
        </div>
    </div>

    <!-- HERO CARD DARK: SALDO BANCARIO Y DISPONIBLE REAL RESULTANTE -->
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm" style="background: linear-gradient(145deg, #18181b 0%, #27272a 100%); color: #ffffff; border-radius: 16px; border: 1px solid #3f3f46;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fs-xs text-uppercase tracking-wider fw-semibold" style="color: #a1a1aa;">
                    Saldo en Cuenta Bancaria
                </span>
                <span class="badge" style="@(AppState.Data.RealAvailableCash >= 0 ? "background: rgba(16, 185, 129, 0.25); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.4);" : "background: rgba(239, 68, 68, 0.25); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.4);")">
                    Disponible: @AppState.Data.RealAvailableCash.ToString("N2") €
                </span>
            </div>

            <div class="my-2">
                <div class="input-group">
                    <input type="number" step="10" 
                           class="form-control text-white border-0 fw-bold fs-4" 
                           style="background: rgba(255, 255, 255, 0.1); border-radius: 12px 0 0 12px; min-height: 48px;" 
                           @bind="bankBalance" />
                    <button class="btn btn-light px-3 fw-semibold fs-xs" 
                            style="border-radius: 0 12px 12px 0; min-height: 48px;" 
                            @onclick="UpdateBankBalance">
                        Guardar
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25 mt-2">
                <span class="fs-xs" style="color: #a1a1aa;">Saldo bruto en tu app bancaria</span>
                <span class="fs-xs fw-semibold text-white">Calcula reservas y disponible</span>
            </div>
        </div>
    </div>

    <!-- SEGMENTED CONTROL: PESTAÑAS DE CONFIGURACIÓN -->
    <div class="segmented-control mb-3">
        <button class="segmented-item @(activeTab == "cloud" ? "active" : "")" @onclick='() => activeTab = "cloud"'>
            ☁️ Nube Supabase
        </button>
        <button class="segmented-item @(activeTab == "backup" ? "active" : "")" @onclick='() => activeTab = "backup"'>
            💾 Copias JSON
        </button>
        <button class="segmented-item @(activeTab == "data" ? "active" : "")" @onclick='() => activeTab = "data"'>
            🛠️ Datos & PWA
        </button>
    </div>

    @if (activeTab == "cloud")
    {
        <!-- SECCIÓN NUBE SUPABASE -->
        <div class="card border rounded-3 p-3 bg-white shadow-xs mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">☁️</span>
                    <div>
                        <span class="fw-bold text-slate-900 fs-sm d-block">Sincronización en la Nube</span>
                        <span class="fs-xs text-muted">Tablas aisladas con prefijo gastos_*</span>
                    </div>
                </div>
                <span class="badge @(Sync.State == SyncState.Synced ? "badge-pastel-success" : (Sync.State == SyncState.Syncing ? "badge-pastel-warning" : (Sync.State == SyncState.Error ? "badge-pastel-danger" : "badge-pastel-dark"))) fs-xs">
                    @(Sync.State == SyncState.Synced ? "🟢 Nube Conectada" : (Sync.State == SyncState.Syncing ? "🔄 Sincronizando..." : (Sync.State == SyncState.Error ? "🔴 Error" : "⚪ Solo Local")))
                </span>
            </div>

            <!-- Cuenta de Usuario -->
            <div class="p-3 bg-slate-50 rounded-3 border mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fs-xs fw-bold text-slate-800 text-uppercase">Sesión de Supabase:</span>
                    @if (Auth.IsSignedIn)
                    {
                        <span class="badge badge-pastel-success fs-xs">Activa</span>
                    }
                    else
                    {
                        <span class="badge badge-pastel-dark fs-xs">Modo Anónimo</span>
                    }
                </div>

                @if (Auth.IsSignedIn)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-xs text-muted text-truncate me-2">@Auth.Email</span>
                        <button class="btn btn-outline-secondary btn-xs rounded-pill px-3 py-1" style="min-height: 32px;" @onclick="HandleLogout">Cerrar</button>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        <input type="email" placeholder="Email de Supabase" class="form-control form-control-sm" style="min-height: 40px;" @bind="loginEmail" />
                        <input type="password" placeholder="Contraseña" class="form-control form-control-sm" style="min-height: 40px;" @bind="loginPassword" />
                        <button class="btn btn-dark btn-sm rounded-pill w-100 fw-semibold" style="min-height: 40px;" @onclick="HandleLogin" disabled="@isLoggingIn">
                            @(isLoggingIn ? "Entrando..." : "Iniciar Sesión en Supabase")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(loginMessage))
                    {
                        <div class="fs-xs text-info mt-2">@loginMessage</div>
                    }
                }
            </div>

            <!-- Botones de sincronización -->
            <div class="d-flex flex-column gap-2">
                <button class="btn btn-dark rounded-pill py-2 d-flex align-items-center justify-content-center gap-2" style="min-height: 44px;" @onclick="SyncPushToCloud">
                    <Icon Name="upload" Size="16" />
                    <span class="fs-sm fw-semibold">Subir Datos Locales a la Nube</span>
                </button>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary rounded-pill flex-fill py-2 d-flex align-items-center justify-content-center gap-1" style="min-height: 44px;" @onclick="TestCloudConnection">
                        <span class="fs-sm">📡 Probar</span>
                    </button>
                    <button class="btn btn-outline-primary rounded-pill flex-fill py-2 d-flex align-items-center justify-content-center gap-1" style="min-height: 44px;" @onclick="SyncPullFromCloud">
                        <Icon Name="download" Size="16" />
                        <span class="fs-sm">Descargar Nube</span>
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(cloudStatusMessage))
            {
                <div class="alert @(cloudStatusIsSuccess ? "alert-success" : "alert-warning") fs-xs py-2 mt-3 mb-0 rounded-3">
                    @cloudStatusMessage
                </div>
            }

            @if (Sync.LastSyncTime.HasValue)
            {
                <div class="fs-xxs text-muted text-center mt-2">
                    Última sincronización: @Sync.LastSyncTime.Value.ToString("g")
                </div>
            }
        </div>
    }
    else if (activeTab == "backup")
    {
        <!-- SECCIÓN COPIAS DE SEGURIDAD JSON -->
        <div class="card border rounded-3 p-3 bg-white shadow-xs mb-3">
            <span class="fs-xs fw-bold text-uppercase tracking-wider text-muted d-block mb-3">
                Exportar e Importar en Archivo JSON
            </span>

            <!-- Exportar -->
            <div class="p-3 bg-slate-50 rounded-3 border mb-3">
                <h6 class="fs-sm fw-bold text-slate-900 mb-1">Descargar Copia de Seguridad</h6>
                <p class="fs-xs text-muted mb-3">
                    Descarga un archivo <code>.json</code> completo con todas tus facturas, gastos, cuotas, fondos y deudas.
                </p>
                <button class="btn btn-outline-primary rounded-pill w-100 py-2 d-flex align-items-center justify-content-center gap-2" style="min-height: 44px;" @onclick="ExportBackup">
                    <Icon Name="download" Size="16" />
                    <span class="fs-sm fw-semibold">Exportar Backup JSON</span>
                </button>
            </div>

            <!-- Importar -->
            <div class="p-3 bg-slate-50 rounded-3 border">
                <h6 class="fs-sm fw-bold text-slate-900 mb-1">Restaurar Copia de Seguridad</h6>
                <p class="fs-xs text-muted mb-2">
                    Selecciona un archivo JSON previamente exportado para recuperar tu contabilidad.
                </p>
                <div class="mb-2">
                    <InputFile OnChange="HandleFileSelected" class="form-control form-control-sm" style="min-height: 40px;" accept=".json" />
                </div>
                @if (!string.IsNullOrEmpty(restoreMessage))
                {
                    <div class="alert alert-info fs-xs py-2 mt-2 mb-0 rounded-2">@restoreMessage</div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- SECCIÓN DATOS Y ESTADO PWA -->
        <div class="d-flex flex-column gap-3 mb-3">
            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <span class="fs-xs fw-bold text-uppercase tracking-wider text-muted d-block mb-3">
                    Gestión y Mantenimiento de Datos
                </span>

                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="pe-2">
                            <span class="fs-sm fw-bold text-slate-800 d-block">Datos de Demostración</span>
                            <span class="fs-xs text-muted">Recarga los clientes, gastos y fondos de prueba.</span>
                        </div>
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 flex-shrink-0" style="min-height: 38px;" @onclick="LoadDemo">
                            Recargar Demo
                        </button>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <div class="pe-2">
                            <span class="fs-sm fw-bold text-danger d-block">Vaciar Todo</span>
                            <span class="fs-xs text-muted">Borra todas las operaciones para empezar de cero.</span>
                        </div>
                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3 flex-shrink-0" style="min-height: 38px;" @onclick="ClearAll">
                            Empezar en Blanco
                        </button>
                    </div>
                </div>
            </div>

            <!-- PWA INFO -->
            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <div class="d-flex align-items-center gap-3">
                    <span class="fs-3">🛡️</span>
                    <div>
                        <span class="fs-sm fw-bold text-slate-900 d-block">100% Offline-First & Privada</span>
                        <p class="fs-xs text-muted m-0 mt-1">
                            Todos los datos residen en el almacenamiento cifrado de tu dispositivo móvil. No hay intermediarios ni trackers.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Inject] private SupabaseSyncService Sync { get; set; } = default!;
    [Inject] private SupabaseAuthService Auth { get; set; } = default!;

    private string activeTab = "cloud";
    private decimal bankBalance;
    private string restoreMessage = "";
    private string cloudStatusMessage = "";
    private bool cloudStatusIsSuccess = true;
    private string loginEmail = "";
    private string loginPassword = "";
    private string loginMessage = "";
    private bool isLoggingIn = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
        Sync.OnSyncStatusChanged += StateHasChanged;
        Auth.OnSessionChanged += StateHasChanged;
        bankBalance = AppState.Data.BankAccountBalance;
    }

    private async Task UpdateBankBalance()
    {
        await AppState.SetBankAccountBalanceAsync(bankBalance);
    }

    private async Task ExportBackup()
    {
        await AppState.DownloadBackupAsync();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var reader = new System.IO.StreamReader(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                var content = await reader.ReadToEndAsync();
                bool ok = await AppState.RestoreBackupAsync(content);
                restoreMessage = ok ? "✅ Copia de seguridad restaurada correctamente." : "❌ Error al leer el archivo JSON.";
                bankBalance = AppState.Data.BankAccountBalance;
            }
        }
        catch (Exception ex)
        {
            restoreMessage = $"❌ Error: {ex.Message}";
        }
    }

    private void LoadDemo()
    {
        AppState.LoadDemoData(saveImmediately: true);
        bankBalance = AppState.Data.BankAccountBalance;
    }

    private async Task ClearAll()
    {
        await AppState.ResetAllDataAsync();
        bankBalance = 0;
    }

    private async Task TestCloudConnection()
    {
        cloudStatusMessage = "Comprobando conexión con Supabase...";
        var (ok, msg) = await Sync.TestConnectionAsync();
        cloudStatusIsSuccess = ok;
        cloudStatusMessage = ok ? "✅ " + msg : "⚠️ " + msg;
    }

    private async Task SyncPushToCloud()
    {
        cloudStatusMessage = "Guardando datos en la nube...";
        var (ok, msg) = await Sync.PushToCloudAsync(AppState.Data);
        cloudStatusIsSuccess = ok;
        cloudStatusMessage = ok ? "✅ " + msg : "❌ " + msg;
    }

    private async Task SyncPullFromCloud()
    {
        cloudStatusMessage = "Descargando datos desde la nube...";
        var (ok, loaded, msg) = await Sync.PullFromCloudAsync();
        cloudStatusIsSuccess = ok;
        if (ok && loaded != null)
        {
            await AppState.SetFullDataAsync(loaded);
            bankBalance = AppState.Data.BankAccountBalance;
            cloudStatusMessage = "✅ Datos actualizados desde la nube.";
        }
        else
        {
            cloudStatusMessage = (ok ? "ℹ️ " : "❌ ") + msg;
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginEmail) || string.IsNullOrWhiteSpace(loginPassword))
        {
            loginMessage = "Ingresa tu email y contraseña de Supabase.";
            return;
        }

        isLoggingIn = true;
        loginMessage = "Conectando...";
        var (ok, err) = await Auth.SignInWithPasswordAsync(loginEmail, loginPassword);
        isLoggingIn = false;
        if (ok)
        {
            loginMessage = "✅ Sesión iniciada con éxito.";
            loginPassword = "";
            await SyncPullFromCloud();
        }
        else
        {
            loginMessage = $"❌ {err}";
        }
    }

    private async Task HandleLogout()
    {
        await Auth.SignOutAsync();
        loginMessage = "Sesión cerrada.";
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        Sync.OnSyncStatusChanged -= StateHasChanged;
        Auth.OnSessionChanged -= StateHasChanged;
    }
}
