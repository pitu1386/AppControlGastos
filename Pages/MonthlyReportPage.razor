@page "/informes"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-monthly-report-view p-3">
    <!-- CABECERA MÓVIL IMPECCABLE -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">📊</span>
                <h1 class="h5 fw-bold text-slate-900 m-0">Informe Mensual & Cierres</h1>
            </div>
            <p class="fs-xs text-muted m-0 mt-1">
                Beneficio contable vs Dinero real en cuenta.
            </p>
        </div>
    </div>

    <!-- SELECTOR DE MES Y AÑO COMPACTO -->
    <div class="card border rounded-3 p-2 bg-white shadow-xs mb-3">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-xs fw-semibold text-muted text-uppercase ps-1">Período:</span>
            <select class="form-select form-select-sm border-0 bg-light fw-bold text-slate-900" style="min-height: 38px;" @bind="selectedMonth">
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
            </select>
            <select class="form-select form-select-sm border-0 bg-light fw-bold text-slate-900" style="min-height: 38px; max-width: 100px;" @bind="selectedYear">
                <option value="2025">2025</option>
                <option value="2026">2026</option>
                <option value="2027">2027</option>
            </select>
        </div>
    </div>

    @{
        // Cálculos del mes seleccionado
        decimal invoiced = AppState.Data.Invoices
            .Where(i => i.IssueDate.Month == selectedMonth && i.IssueDate.Year == selectedYear)
            .Sum(i => i.TotalInvoice);

        decimal collected = AppState.Data.Invoices
            .Where(i => i.IsCollected && i.CollectedDate.HasValue && i.CollectedDate.Value.Month == selectedMonth && i.CollectedDate.Value.Year == selectedYear)
            .Sum(i => i.CollectedAmount > 0 ? i.CollectedAmount : i.TotalInvoice);

        decimal pending = invoiced - collected;

        decimal profExpenses = AppState.Data.Expenses
            .Where(e => e.Scope == ExpenseScope.Profesional && e.Date.Month == selectedMonth && e.Date.Year == selectedYear)
            .Sum(e => e.Amount);

        decimal persExpenses = AppState.Data.Expenses
            .Where(e => e.Scope == ExpenseScope.Personal && e.Date.Month == selectedMonth && e.Date.Year == selectedYear)
            .Sum(e => e.Amount);

        decimal sharedExpensesUser = AppState.Data.Expenses
            .Where(e => e.Scope == ExpenseScope.Compartido && e.Date.Month == selectedMonth && e.Date.Year == selectedYear)
            .Sum(e => e.UserShareAmount);

        decimal taxReserves = AppState.Data.Invoices
            .Where(i => i.IssueDate.Month == selectedMonth && i.IssueDate.Year == selectedYear)
            .Sum(i => i.IrpfReserveAmount + i.VatAmount);

        decimal profProfit = invoiced - profExpenses - taxReserves;
        decimal personalAvailableResult = collected - profExpenses - sharedExpensesUser - persExpenses - taxReserves;

        decimal savingsTarget = AppState.Data.SavingsConfig.MonthlySavingsTarget;
        decimal savingsAchieved = Math.Max(0m, personalAvailableResult);
        bool savingsMet = savingsAchieved >= savingsTarget && savingsTarget > 0;

        // Cálculos mes anterior
        int prevM = selectedMonth == 1 ? 12 : selectedMonth - 1;
        int prevY = selectedMonth == 1 ? selectedYear - 1 : selectedYear;
        decimal prevInvoiced = AppState.Data.Invoices
            .Where(i => i.IssueDate.Month == prevM && i.IssueDate.Year == prevY)
            .Sum(i => i.TotalInvoice);
        decimal prevCollected = AppState.Data.Invoices
            .Where(i => i.IsCollected && i.CollectedDate.HasValue && i.CollectedDate.Value.Month == prevM && i.CollectedDate.Value.Year == prevY)
            .Sum(i => i.CollectedAmount > 0 ? i.CollectedAmount : i.TotalInvoice);

        decimal diffInvoiced = invoiced - prevInvoiced;
        decimal diffCollected = collected - prevCollected;
    }

    <!-- HERO CARD DARK: RESULTADO DISPONIBLE REAL -->
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm" style="background: linear-gradient(145deg, #18181b 0%, #27272a 100%); color: #ffffff; border-radius: 16px; border: 1px solid #3f3f46;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="fs-xs text-uppercase tracking-wider fw-semibold" style="color: #a1a1aa;">
                    Disponible Personal Real Generado
                </span>
                <span class="badge" style="@(savingsMet ? "background: rgba(16, 185, 129, 0.25); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.4);" : "background: rgba(245, 158, 11, 0.25); color: #fde68a; border: 1px solid rgba(245, 158, 11, 0.4);")">
                    @(savingsMet ? "✓ Meta Cubierta" : "Meta Ahorro en curso")
                </span>
            </div>

            <div class="d-flex align-items-baseline gap-2 my-2">
                <h2 class="fs-2 fw-bold text-white mb-0">
                    @(personalAvailableResult >= 0 ? "+" : "")@personalAvailableResult.ToString("N2") €
                </h2>
            </div>

            <div class="row g-2 pt-2 border-top border-secondary border-opacity-25 mt-2">
                <div class="col-4">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">Beneficio Contable</span>
                    <span class="fs-sm fw-bold text-white">@profProfit.ToString("N0") €</span>
                </div>
                <div class="col-4">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">Cobrado Real</span>
                    <span class="fs-sm fw-bold text-emerald-400" style="color: #34d399;">@collected.ToString("N0") €</span>
                </div>
                <div class="col-4 text-end">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">Por Cobrar (90d)</span>
                    <span class="fs-sm fw-bold text-amber-400" style="color: #fbbf24;">@pending.ToString("N0") €</span>
                </div>
            </div>
        </div>
    </div>

    <!-- SEGMENTED CONTROL: FICHA vs COMPARATIVA -->
    <div class="segmented-control mb-3">
        <button class="segmented-item @(activeTab == "summary" ? "active" : "")" @onclick='() => activeTab = "summary"'>
            Desglose Mensual
        </button>
        <button class="segmented-item @(activeTab == "compare" ? "active" : "")" @onclick='() => activeTab = "compare"'>
            vs Mes Anterior
        </button>
    </div>

    @if (activeTab == "summary")
    {
        <!-- RESUMEN MENSUAL EJECUTIVO -->
        <div class="card border rounded-3 p-3 bg-white shadow-xs mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <span class="fs-xs fw-bold text-uppercase tracking-wider text-slate-800">
                    Liquidación @((new DateTime(selectedYear, selectedMonth, 1)).ToString("MMMM yyyy").ToUpper())
                </span>
                <span class="badge badge-pastel-dark fs-xs">Oficial Interno</span>
            </div>

            <div class="d-flex flex-column gap-2">
                <!-- Entradas -->
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span class="fs-xs text-slate-700">Facturación Emitida</span>
                    <span class="fs-xs fw-bold text-slate-900">@invoiced.ToString("N2") €</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span class="fs-xs text-success fw-medium">Cobrado en Cuenta Efectivo</span>
                    <span class="fs-xs fw-bold text-success">+@collected.ToString("N2") €</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span class="fs-xs text-warning fw-medium">Pendiente de Cobro (retrasos/90 días)</span>
                    <span class="fs-xs fw-bold text-warning">@pending.ToString("N2") €</span>
                </div>

                <!-- Gastos y deducciones -->
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span class="fs-xs text-muted">Gastos Profesionales (autónomos, asesoría)</span>
                    <span class="fs-xs text-danger">-@profExpenses.ToString("N2") €</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span class="fs-xs text-muted">Gastos Particulares de vida</span>
                    <span class="fs-xs text-danger">-@persExpenses.ToString("N2") €</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span class="fs-xs text-muted">Gastos Compartidos (tu 50% vivienda/hogar)</span>
                    <span class="fs-xs text-danger">-@sharedExpensesUser.ToString("N2") €</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span class="fs-xs text-muted">Reservas Fiscales retenidas (IRPF / IVA)</span>
                    <span class="fs-xs text-danger">-@taxReserves.ToString("N2") €</span>
                </div>

                <!-- Resultados destacados -->
                <div class="p-2 rounded-2 mt-2 bg-slate-50 border d-flex justify-content-between align-items-center">
                    <span class="fs-xs fw-bold text-slate-800">Beneficio Profesional Contable:</span>
                    <span class="fs-sm fw-bold text-primary">@profProfit.ToString("N2") €</span>
                </div>

                <div class="p-2 rounded-2 d-flex justify-content-between align-items-center" style="background: var(--pastel-success-bg); border: 1px solid var(--pastel-success-border);">
                    <span class="fs-xs fw-bold text-emerald-900">Resultado Disponible Personal:</span>
                    <span class="fs-sm fw-bold text-success">@personalAvailableResult.ToString("N2") €</span>
                </div>
            </div>

            <!-- Meta de Ahorro del Mes -->
            <div class="mt-3 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fs-xs fw-bold text-slate-800 d-block">Meta Mensual de Ahorro</span>
                        <span class="fs-xxs text-muted">Objetivo fijado: @savingsTarget.ToString("N0") €</span>
                    </div>
                    <span class="badge @(savingsMet ? "badge-pastel-success" : "badge-pastel-warning") fs-xs">
                        @savingsAchieved.ToString("N2") € @(savingsMet ? "✓ Conseguido" : "⚠️ En curso")
                    </span>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- COMPARATIVA CON EL MES ANTERIOR -->
        <div class="card border rounded-3 p-3 bg-white shadow-xs mb-3">
            <span class="fs-xs fw-bold text-uppercase tracking-wider text-muted d-block mb-3">
                Comparativa vs @((new DateTime(prevY, prevM, 1)).ToString("MMMM yyyy").ToUpper())
            </span>

            <div class="d-flex flex-column gap-3">
                <div class="p-3 bg-slate-50 rounded-3 border">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fs-xs text-muted d-block">Facturado Mes Anterior</span>
                            <span class="fs-6 fw-bold text-slate-900">@prevInvoiced.ToString("N2") €</span>
                        </div>
                        <span class="badge @(diffInvoiced >= 0 ? "badge-pastel-success" : "badge-pastel-danger") fs-xs">
                            @(diffInvoiced >= 0 ? "+" : "")@diffInvoiced.ToString("N2") €
                        </span>
                    </div>
                    <span class="fs-xxs text-muted mt-1 d-block">Mes actual: @invoiced.ToString("N2") €</span>
                </div>

                <div class="p-3 bg-slate-50 rounded-3 border">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fs-xs text-muted d-block">Cobrado Real Mes Anterior</span>
                            <span class="fs-6 fw-bold text-slate-900">@prevCollected.ToString("N2") €</span>
                        </div>
                        <span class="badge @(diffCollected >= 0 ? "badge-pastel-success" : "badge-pastel-danger") fs-xs">
                            @(diffCollected >= 0 ? "+" : "")@diffCollected.ToString("N2") €
                        </span>
                    </div>
                    <span class="fs-xxs text-muted mt-1 d-block">Mes actual: @collected.ToString("N2") €</span>
                </div>

                <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="fs-sm">💡</span>
                        <span class="fs-xs fw-bold text-slate-900">Diagnóstico de Tendencia</span>
                    </div>
                    <p class="fs-xs text-muted m-0">
                        @if (collected >= profExpenses + sharedExpensesUser + persExpenses)
                        {
                            <span>Tu tesorería cobrada en este mes cubre holgadamente todos tus costes fijos y gastos de vida.</span>
                        }
                        else
                        {
                            <span>Existe desfase temporal entre facturación y cobro. Asegúrate de tener respaldo en el colchón de liquidez.</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int selectedMonth = DateTime.Today.Month;
    private int selectedYear = DateTime.Today.Year;
    private string activeTab = "summary";

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
