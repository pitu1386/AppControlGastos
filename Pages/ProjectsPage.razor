@page "/proyectos"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-projects-view p-3">
    <!-- Encabezado Móvil Limpio -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h5 fw-bold text-slate-900 m-0">Proyectos & Rentabilidad</h1>
            <p class="text-muted fs-xs m-0">Horas facturables y rentabilidad neta</p>
        </div>
        <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-xs d-flex align-items-center gap-1.5" @onclick="OpenAddProjectModal">
            <Icon Name="plus" Size="14" />
            <span>Nuevo Proyecto</span>
        </button>
    </div>

    <!-- TARJETA HERO: VALOR GENERADO Y POTENCIAL -->
    @{
        var activeProjects = AppState.Data.Projects.Where(p => p.Status == ProjectStatusType.EnCurso).ToList();
        decimal totalValue = AppState.Data.Projects.Sum(p => p.ValueGenerated);
        decimal potentialPending = AppState.Data.ProjectsPotentialIncome;
    }
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm">
        <div class="card-body p-3.5">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
                <span class="fs-xs text-uppercase tracking-wider text-slate-400 fw-bold">Valor Generado en Proyectos</span>
                <span class="badge fs-xs rounded-pill" style="background-color: var(--pastel-success-bg); color: var(--pastel-success-text); border: 1px solid var(--pastel-success-border);">
                    @activeProjects.Count en curso
                </span>
            </div>

            <div class="d-flex align-items-baseline justify-content-between my-1">
                <div class="financial-display-amount fw-bold tracking-tight text-white">
                    @totalValue.ToString("N2") €
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2.5 pt-2 border-top border-slate-700 fs-xs">
                <span class="text-slate-400">
                    Pendiente facturar: <strong class="text-white">@potentialPending.ToString("N0") €</strong>
                </span>
                <span class="text-slate-400">
                    Horas facturables: <strong class="text-slate-300">@AppState.Data.Projects.Sum(p => p.BillableHoursWorked) h</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS: PROYECTOS vs CALCULADORA €/h -->
    <div class="segmented-control mb-3">
        <button type="button" class="segmented-item @(activeTab == "proyectos" ? "active" : "")" @onclick='() => activeTab = "proyectos"'>
            Proyectos (@AppState.Data.Projects.Count)
        </button>
        <button type="button" class="segmented-item @(activeTab == "calculadora" ? "active" : "")" @onclick='() => activeTab = "calculadora"'>
            Calculadora €/h Neta
        </button>
    </div>

    @if (activeTab == "proyectos")
    {
        @if (!AppState.Data.Projects.Any())
        {
            <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
                <Icon Name="folder" Size="28" Class="text-muted opacity-50 mb-2" />
                <div class="fw-bold text-slate-800 small">Sin proyectos registrados</div>
                <p class="text-muted fs-xs mb-3">Registra tus proyectos de diseño/interiorismo para imputar horas y calcular ingresos.</p>
                <div>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenAddProjectModal">
                        + Registrar primer proyecto
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var proj in AppState.Data.Projects)
                {
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
                        <div class="p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="category-icon-bubble">
                                        📐
                                    </div>
                                    <div>
                                        <div class="fw-bold text-slate-900 small">@proj.Name</div>
                                        <div class="text-muted fs-xs">
                                            Cliente: @proj.Client • <strong class="text-slate-800">@proj.HourlyRate.ToString("N0") €/h</strong>
                                        </div>
                                    </div>
                                </div>
                                <span class="badge rounded-pill fs-xs @(proj.Status == ProjectStatusType.EnCurso ? "bg-light text-dark border" : "bg-success-subtle text-success border")">
                                    @proj.Status
                                </span>
                            </div>

                            <!-- Métricas de la tarjeta -->
                            <div class="row g-2 my-2 py-2 border-top border-bottom border-slate-100 fs-xs">
                                <div class="col-4">
                                    <span class="text-muted d-block">Horas</span>
                                    <strong class="text-slate-900 fs-6">@proj.BillableHoursWorked / @proj.EstimatedHours h</strong>
                                </div>
                                <div class="col-4 text-center">
                                    <span class="text-muted d-block">Generado</span>
                                    <strong class="text-emerald-700 fs-6">@proj.ValueGenerated.ToString("N0") €</strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="text-muted d-block">Presupuesto</span>
                                    <strong class="text-slate-900 fs-6">@proj.EstimatedBudget.ToString("N0") €</strong>
                                </div>
                            </div>

                            <!-- Barra de progreso -->
                            <div class="my-2">
                                <div class="d-flex justify-content-between fs-xs text-muted mb-1">
                                    <span>Progreso de horas</span>
                                    <span>@proj.ProgressPercentage%</span>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 3px; background-color: var(--color-slate-100);">
                                    <div class="progress-bar bg-dark" role="progressbar" style="width: @proj.ProgressPercentage%;"></div>
                                </div>
                            </div>

                            <!-- Últimas horas imputadas -->
                            @if (proj.WorkLogs.Any())
                            {
                                <div class="bg-light p-2 rounded-2 mt-2 mb-2 fs-xs">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-muted fw-semibold">Última imputación:</span>
                                        @{
                                            var lastLog = proj.WorkLogs.First();
                                        }
                                        <span class="fw-bold text-slate-800">@lastLog.Date.ToString("dd/MM") • @lastLog.Hours h (@(lastLog.Type == HourLogType.Facturable ? "Facturable" : "Gestión"))</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(lastLog.Description))
                                    {
                                        <div class="text-muted text-truncate">@lastLog.Description</div>
                                    }
                                </div>
                            }

                            <!-- Botones de acción -->
                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 fs-xs d-flex align-items-center gap-1"
                                        @onclick="() => DeleteProject(proj.Id)">
                                    <Icon Name="trash" Size="13" />
                                    <span>Eliminar</span>
                                </button>
                                <button class="btn btn-sm btn-primary rounded-pill px-3 py-1 shadow-xs fs-xs d-flex align-items-center gap-1 font-medium"
                                        @onclick="() => OpenAddHoursModal(proj)">
                                    <Icon Name="plus" Size="13" />
                                    <span>Imputar Horas</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- CALCULADORA DE TARIFA NETA REAL (LIMPIA Y SOBRIA) -->
        decimal billableRatio = calcTotalDailyHours > 0 ? (calcBillableDailyHours / calcTotalDailyHours) : 0.75m;
        decimal effectiveGrossRate = calcHourlyRate * billableRatio;
        decimal taxReservePerHour = effectiveGrossRate * (calcTaxRate / 100m);
        decimal monthlyFixed = AppState.Data.FixedExpenses.Where(f => f.IsActive && f.Scope == ExpenseScope.Profesional).Sum(f => f.MonthlyReserveAmount);
        decimal estimatedMonthlyHours = 100m;
        decimal fixedCostPerHour = estimatedMonthlyHours > 0 ? Math.Round(monthlyFixed / estimatedMonthlyHours, 2) : 3.50m;
        decimal netHourlyProfit = Math.Round(effectiveGrossRate - taxReservePerHour - fixedCostPerHour, 2);

        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
            <div class="p-3.5">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="fs-5">🧮</span>
                    <div>
                        <h2 class="h6 fw-bold m-0 text-slate-900">¿Cuánto me queda realmente limpio por hora?</h2>
                        <span class="fs-xs text-muted">Descuenta horas de gestión, impuestos y costes fijos</span>
                    </div>
                </div>

                <div class="row g-2.5 mb-3">
                    <div class="col-6">
                        <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Tarifa Nominal Cliente</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="1" class="form-control fw-bold" @bind="calcHourlyRate" />
                            <span class="input-group-text fs-xs">€/h</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Reserva IRPF (%)</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="1" class="form-control fw-bold" @bind="calcTaxRate" />
                            <span class="input-group-text fs-xs">%</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Horas Totales / Día</label>
                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="calcTotalDailyHours" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Horas Facturables / Día</label>
                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="calcBillableDailyHours" />
                    </div>
                </div>

                <!-- RESULTADO DESTACADO -->
                <div class="p-3 rounded-3 mb-3" style="background-color: var(--pastel-success-bg); border: 1px solid var(--pastel-success-border);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fs-xs fw-bold" style="color: var(--pastel-success-text);">Beneficio Neto Real Limpio</span>
                        <span class="badge rounded-pill bg-white text-dark border fs-xs">Bolsillo real</span>
                    </div>
                    <div class="fs-2 fw-bolder" style="color: var(--pastel-success-text);">
                        @netHourlyProfit.ToString("N2") € / h
                    </div>
                    <span class="fs-xs text-muted">
                        De tus @calcHourlyRate.ToString("N0") €/h nominales, te quedan limpios tras descontar horas no cobradas, impuestos y fijos.
                    </span>
                </div>

                <!-- DESGLOSE MATEMÁTICO -->
                <div class="d-flex flex-column gap-2 fs-xs border-top pt-2.5 text-muted">
                    <div class="d-flex justify-content-between">
                        <span>Efectivo por horas trabajadas:</span>
                        <strong class="text-slate-800">@effectiveGrossRate.ToString("N2") €/h</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Reserva impuestos (@calcTaxRate%):</span>
                        <strong class="text-danger">-@taxReservePerHour.ToString("N2") €/h</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Coste fijos profesionales (Autónomos + Soft):</span>
                        <strong class="text-danger">-@fixedCostPerHour.ToString("N2") €/h</strong>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL CREAR PROYECTO -->
<ModalDialog IsOpen="isProjectModalOpen" Title="Nuevo Proyecto" OnClose="() => isProjectModalOpen = false">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Nombre del Proyecto</label>
                <input type="text" class="form-control" @bind="newProject.Name" placeholder="Ej. Calle Serrano — Reforma Interior" />
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Cliente</label>
                <input type="text" class="form-control" @bind="newProject.Client" placeholder="Nombre cliente" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Tarifa Acordada (€/h)</label>
                <input type="number" step="1" class="form-control" @bind="newProject.HourlyRate" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Horas Estimadas</label>
                <input type="number" step="5" class="form-control" @bind="newProject.EstimatedHours" />
            </div>
            <div class="col-12 bg-light p-2.5 rounded-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted fs-xs">Presupuesto estimado total:</span>
                    <strong class="text-slate-900 fs-6">@newProject.EstimatedBudget.ToString("N2") €</strong>
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="() => isProjectModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveProject">Crear Proyecto</button>
    </Footer>
</ModalDialog>

<!-- MODAL IMPUTAR HORAS -->
<ModalDialog IsOpen="isHoursModalOpen" Title="Imputar Horas al Proyecto" OnClose="() => isHoursModalOpen = false">
    <ChildContent>
        @if (selectedProjectForHours != null)
        {
            <div class="p-2.5 bg-light rounded-2 mb-3 fs-xs">
                <span>Proyecto: <strong class="text-slate-900">@selectedProjectForHours.Name</strong> (@selectedProjectForHours.HourlyRate.ToString("N0") €/h)</span>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Fecha</label>
                    <input type="date" class="form-control" @bind="logDate" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Número de Horas</label>
                    <input type="number" step="0.5" class="form-control" @bind="logHours" />
                </div>
                <div class="col-md-12">
                    <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Tipo de Horas</label>
                    <select class="form-select" @bind="logType">
                        <option value="@HourLogType.Facturable">Horas Facturables (Diseño, planos, ejecución directa)</option>
                        <option value="@HourLogType.GestionYReuniones">Gestión / Reuniones / Coordinación proveedores</option>
                        <option value="@HourLogType.NoFacturable">No facturable / Tareas administrativas</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Descripción de la Tarea</label>
                    <input type="text" class="form-control" @bind="logDescription" placeholder="Ej. Modelado 3D de cocina y selección de materiales..." />
                </div>
                @if (logType == HourLogType.Facturable)
                {
                    <div class="col-12 bg-light p-2.5 rounded-2 text-end">
                        <span class="fs-xs text-muted me-2">Valor generado:</span>
                        <strong class="text-emerald-700 fs-6">@((logHours * selectedProjectForHours.HourlyRate).ToString("N2")) €</strong>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="() => isHoursModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveWorkLog">Guardar Horas</button>
    </Footer>
</ModalDialog>

@code {
    private string activeTab = "proyectos";
    private decimal calcHourlyRate = 35m;
    private decimal calcTotalDailyHours = 8m;
    private decimal calcBillableDailyHours = 6m;
    private decimal calcTaxRate = 20m;

    private bool isProjectModalOpen = false;
    private Project newProject = new();

    private bool isHoursModalOpen = false;
    private Project? selectedProjectForHours;
    private decimal logHours = 4m;
    private HourLogType logType = HourLogType.Facturable;
    private string logDescription = "";
    private DateTime logDate = DateTime.Today;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private void OpenAddProjectModal()
    {
        newProject = new Project { HourlyRate = 35m, EstimatedHours = 100m };
        isProjectModalOpen = true;
    }

    private async Task SaveProject()
    {
        if (string.IsNullOrWhiteSpace(newProject.Name)) return;
        await AppState.AddProjectAsync(newProject);
        isProjectModalOpen = false;
    }

    private void OpenAddHoursModal(Project proj)
    {
        selectedProjectForHours = proj;
        logHours = 4m;
        logType = HourLogType.Facturable;
        logDescription = "";
        logDate = DateTime.Today;
        isHoursModalOpen = true;
    }

    private async Task SaveWorkLog()
    {
        if (selectedProjectForHours != null && logHours > 0)
        {
            await AppState.AddWorkLogAsync(selectedProjectForHours.Id, logHours, logType, logDescription, logDate);
            isHoursModalOpen = false;
        }
    }

    private async Task DeleteProject(string id)
    {
        await AppState.DeleteProjectAsync(id);
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
