@page "/gastos-fijos"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-fixed-expenses-view p-3">
    <!-- Encabezado Móvil Limpio -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h5 fw-bold text-slate-900 m-0">Gastos Fijos & Reservas</h1>
            <p class="text-muted fs-xs m-0">Pagos recurrentes y reserva mensual</p>
        </div>
        <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-xs d-flex align-items-center gap-1.5" @onclick="OpenAddModal">
            <Icon Name="plus" Size="14" />
            <span>Nuevo Fijo</span>
        </button>
    </div>

    <!-- TARJETA HERO: RESERVA MENSUAL TOTAL -->
    @{
        decimal monthlyInvoiced = AppState.Data.CurrentMonthInvoiced > 0 ? AppState.Data.CurrentMonthInvoiced : 4000m;
        decimal ratio = (AppState.Data.ImmediateFixedExpenses / monthlyInvoiced) * 100m;
        var activeFixed = AppState.Data.FixedExpenses.Where(f => f.IsActive).ToList();
        var filteredList = selectedScope.HasValue 
            ? activeFixed.Where(f => f.Scope == selectedScope.Value).ToList() 
            : activeFixed;
    }
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm">
        <div class="card-body p-3.5">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
                <span class="fs-xs text-uppercase tracking-wider text-slate-400 fw-bold">Reserva Mensual Necesaria</span>
                <span class="badge fs-xs rounded-pill" style="background-color: var(--pastel-warning-bg) !important; color: var(--pastel-warning-text) !important; border: 1px solid var(--pastel-warning-border) !important;">
                    @activeFixed.Count fijos activos
                </span>
            </div>

            <div class="d-flex align-items-baseline justify-content-between my-1">
                <div class="financial-display-amount fw-bold tracking-tight text-white">
                    @AppState.Data.ImmediateFixedExpenses.ToString("N2") € <span class="fs-6 fw-normal text-slate-300">/ mes</span>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2.5 pt-2 border-top border-slate-700 fs-xs">
                <span class="text-slate-400">
                    Profesional: <strong class="text-white">@activeFixed.Where(f => f.Scope == ExpenseScope.Profesional).Sum(f => f.MonthlyReserveAmount).ToString("N0") €/mes</strong>
                </span>
                <span class="text-slate-400">
                    Absorbe: <strong class="text-slate-300">@ratio.ToString("N1")%</strong> facturación
                </span>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS: FILTRO POR ÁMBITO -->
    <div class="segmented-control mb-3">
        <button type="button" class="segmented-item @(!selectedScope.HasValue ? "active" : "")" @onclick="() => selectedScope = null">
            Todos (@activeFixed.Count)
        </button>
        <button type="button" class="segmented-item @(selectedScope == ExpenseScope.Profesional ? "active" : "")" @onclick="() => selectedScope = ExpenseScope.Profesional">
            Profesional (@activeFixed.Count(f => f.Scope == ExpenseScope.Profesional))
        </button>
        <button type="button" class="segmented-item @(selectedScope == ExpenseScope.Personal ? "active" : "")" @onclick="() => selectedScope = ExpenseScope.Personal">
            Personal (@activeFixed.Count(f => f.Scope == ExpenseScope.Personal))
        </button>
        <button type="button" class="segmented-item @(selectedScope == ExpenseScope.Compartido ? "active" : "")" @onclick="() => selectedScope = ExpenseScope.Compartido">
            Común (@activeFixed.Count(f => f.Scope == ExpenseScope.Compartido))
        </button>
    </div>

    <!-- LISTADO DE GASTOS FIJOS EN TARJETAS TÁCTILES MÓVILES -->
    @if (!filteredList.Any())
    {
        <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
            <Icon Name="repeat" Size="28" Class="text-muted opacity-50 mb-2" />
            <div class="fw-bold text-slate-800 small">No hay gastos fijos en este ámbito</div>
            <p class="text-muted fs-xs mb-3">Registra compromisos como la cuota de autónomos, gestoría, suministros o software.</p>
            <div>
                <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenAddModal">
                    + Añadir gasto fijo
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
            <div class="divide-y">
                @foreach (var item in filteredList.OrderByDescending(f => f.MonthlyReserveAmount))
                {
                    <div class="p-3 border-bottom border-slate-100 hover-bg-light transition">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="category-icon-bubble">
                                    @GetCategoryIcon(item.Category)
                                </div>
                                <div>
                                    <div class="fw-bold text-slate-900 small">@item.Concept</div>
                                    <div class="d-flex align-items-center gap-1.5 mt-0.5">
                                        <span class="badge bg-light text-secondary border fs-xs">@item.Category</span>
                                        <span class="badge bg-light text-muted border fs-xs">@item.FrequencyLabel</span>
                                        <span class="text-muted fs-xs">Día @item.DayOfMonth</span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-slate-900 fs-6">@item.MonthlyReserveAmount.ToString("N2") €</div>
                                <div class="fs-xs text-muted">reserva / mes</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-slate-50 fs-xs">
                            <div class="text-muted">
                                Pago: <strong class="text-slate-800">@item.Amount.ToString("N2") €</strong> (@item.FrequencyLabel.ToLower())
                            </div>
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5 fs-xs d-flex align-items-center gap-1"
                                    @onclick="() => DeleteFixedExpense(item.Id)">
                                <Icon Name="trash" Size="12" />
                                <span>Eliminar</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- MODAL NUEVO GASTO FIJO -->
<ModalDialog IsOpen="isModalOpen" Title="Nuevo Gasto Fijo Recurrente" OnClose="CloseModal">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Concepto</label>
                <input type="text" class="form-control" @bind="newItem.Concept" placeholder="Ej. Cuota Autónomos, Gestoría, Figma..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Importe Recurrente (€)</label>
                <input type="number" step="0.01" class="form-control" @bind="newItem.Amount" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Categoría</label>
                <select class="form-select" @bind="newItem.Category">
                    <option value="Autónomos">Autónomos</option>
                    <option value="Gestoría">Gestoría</option>
                    <option value="Software">Software</option>
                    <option value="Vivienda">Vivienda</option>
                    <option value="Suministros">Suministros</option>
                    <option value="Transporte">Transporte</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Ámbito</label>
                <select class="form-select" @bind="newItem.Scope">
                    <option value="@ExpenseScope.Profesional">Profesional (Actividad)</option>
                    <option value="@ExpenseScope.Personal">Personal</option>
                    <option value="@ExpenseScope.Compartido">Compartido</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Periodicidad</label>
                <select class="form-select" @bind="newItem.Frequency">
                    <option value="@FrequencyType.Mensual">Mensual</option>
                    <option value="@FrequencyType.Bimestral">Bimestral</option>
                    <option value="@FrequencyType.Trimestral">Trimestral</option>
                    <option value="@FrequencyType.Anual">Anual</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Día de cobro habitual</label>
                <input type="number" class="form-control" @bind="newItem.DayOfMonth" min="1" max="31" />
            </div>
            <div class="col-12 bg-light p-2.5 rounded-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted fs-xs">Reserva mensual equivalente calculada:</span>
                    <strong class="text-slate-900 fs-6">@newItem.MonthlyReserveAmount.ToString("N2") € / mes</strong>
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="CloseModal">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveFixedExpense">Guardar Fijo</button>
    </Footer>
</ModalDialog>

@code {
    private ExpenseScope? selectedScope = null;
    private bool isModalOpen = false;
    private FixedExpense newItem = new();

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private string GetCategoryIcon(string category) => category switch
    {
        "Autónomos" => "💼",
        "Gestoría" => "⚖️",
        "Software" => "💻",
        "Vivienda" => "🏠",
        "Suministros" => "⚡",
        "Transporte" => "🚗",
        _ => "📦"
    };

    private void OpenAddModal()
    {
        newItem = new FixedExpense { Frequency = FrequencyType.Mensual, DayOfMonth = 1, Category = "Autónomos" };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveFixedExpense()
    {
        if (string.IsNullOrWhiteSpace(newItem.Concept) || newItem.Amount <= 0) return;
        await AppState.AddFixedExpenseAsync(newItem);
        isModalOpen = false;
    }

    private async Task DeleteFixedExpense(string id)
    {
        await AppState.DeleteFixedExpenseAsync(id);
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
