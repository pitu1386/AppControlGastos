@page "/cuotas"
@inject AppStateService AppState
@implements IDisposable

<div class="installments-container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h4 fw-bold text-slate-900 m-0">Gastos a Plazos & Cuotas</h1>
            <p class="text-muted small m-0 mt-1">
                Control de compras financiadas y pagos fraccionados. Conoce exactamente cuánto dinero tienes comprometido a futuro.
            </p>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-xs d-flex align-items-center justify-content-center gap-1.5 w-100 w-md-auto" @onclick="OpenAddModal">
            <Icon Name="plus" Size="16" />
            <span>Nueva Compra en Cuotas</span>
        </button>
    </div>

    <!-- TARJETAS DE RESUMEN DE CUOTAS (2 arriba, 1 ancho completo en móvil) -->
    <div class="row g-2.5 g-md-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="card p-2.5 p-md-3 bg-white border-0 shadow-sm h-100">
                <span class="text-muted fs-xs fw-semibold text-uppercase text-truncate">Comprometido Futuro</span>
                <span class="fs-5 fs-md-4 fw-bold text-danger mt-1">
                    @AppState.Data.TotalCommittedFutureInstallments.ToString("N2") €
                </span>
                <small class="text-muted fs-xs d-none d-sm-block">Pendiente de amortizar</small>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card p-2.5 p-md-3 bg-white border-0 shadow-sm h-100">
                <span class="text-muted fs-xs fw-semibold text-uppercase text-truncate">Cuotas Este Mes</span>
                <span class="fs-5 fs-md-4 fw-bold text-slate-900 mt-1">
                    @AppState.Data.NextInstallmentsDueThisMonth.ToString("N2") €
                </span>
                <small class="text-muted fs-xs d-none d-sm-block">Impacto mensual</small>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card p-2.5 p-md-3 bg-white border-0 shadow-sm h-100">
                <span class="text-muted fs-xs fw-semibold text-uppercase text-truncate">Total Ya Amortizado</span>
                <span class="fs-5 fs-md-4 fw-bold text-success mt-1">
                    @AppState.Data.Installments.Sum(i => i.PaidAmount).ToString("N2") €
                </span>
                <small class="text-muted fs-xs d-none d-sm-block">Pagado hasta la fecha</small>
            </div>
        </div>
    </div>

    <!-- LISTADO DE COMPRAS EN CUOTAS -->
    <div class="row g-3 g-md-4">
        @if (!AppState.Data.Installments.Any())
        {
            <div class="col-12">
                <div class="card shadow-sm border-0 p-4 p-md-5 text-center text-muted">
                    <Icon Name="credit-card" Size="32" Class="opacity-50 mb-2" />
                    <h5 class="fs-6 fw-bold">No tienes compras en cuotas registradas</h5>
                    <p class="small mb-0">Registra aquí compras fraccionadas como equipamiento, tecnología o viajes.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in AppState.Data.Installments)
            {
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom py-2.5 px-3 px-md-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="h6 fw-bold m-0 text-slate-900">@item.Concept</h2>
                                <span class="badge bg-light text-secondary border fs-xs mt-0.5">@item.Category • @item.Scope</span>
                            </div>
                            <span class="badge @(item.IsCompleted ? "bg-success-subtle text-success border" : "bg-light text-dark border") px-2 py-1 fs-xs">
                                Cuota @item.PaidInstallments de @item.TotalInstallments
                            </span>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            <div class="row g-2.5 mb-3">
                                <div class="col-6">
                                    <span class="fs-xs text-muted d-block">Importe Total</span>
                                    <span class="fw-bold text-slate-900 fs-6 fs-md-5">@item.TotalAmount.ToString("N2") €</span>
                                </div>
                                <div class="col-6 text-end">
                                    <span class="fs-xs text-muted d-block">Importe por Cuota</span>
                                    <span class="fw-bold text-slate-900 fs-6 fs-md-5">@item.InstallmentAmount.ToString("N2") € / mes</span>
                                </div>
                                <div class="col-6">
                                    <span class="fs-xs text-muted d-block">Comprometido Restante</span>
                                    <span class="fw-bold text-danger fs-6 fs-md-5">@item.CommittedFutureAmount.ToString("N2") €</span>
                                    <div class="fs-xs text-muted">Quedan @item.RemainingInstallments cuotas</div>
                                </div>
                                <div class="col-6 text-end">
                                    <span class="fs-xs text-muted d-block">Próximo Vencimiento</span>
                                    <span class="fw-bold text-slate-900 fs-6 fs-md-5">@item.NextDueDate.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>

                            <!-- BARRA DE PROGRESO DE CUOTAS -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between fs-xs text-muted mb-1">
                                    <span>Progreso amortizado</span>
                                    <span>@item.PaidInstallments de @item.TotalInstallments (@((int)((double)item.PaidInstallments / item.TotalInstallments * 100))%)</span>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 4px; background-color: var(--color-slate-100);">
                                    <div class="progress-bar bg-dark" role="progressbar" 
                                         style="width: @((double)item.PaidInstallments / item.TotalInstallments * 100)%;">
                                    </div>
                                </div>
                            </div>

                            <!-- PRÓXIMAS FECHAS PROYECTADAS -->
                            @if (!item.IsCompleted)
                            {
                                <div class="bg-light p-2.5 p-md-3 rounded-3 border mb-3">
                                    <span class="fw-bold text-muted fs-xs text-uppercase d-block mb-1.5">Próximos Vencimientos</span>
                                    <div class="d-flex flex-wrap gap-1.5">
                                        @foreach (var upcoming in item.GetUpcomingInstallments().Take(4))
                                        {
                                            <span class="badge bg-white text-dark border px-2 py-1 fs-xs font-monospace">
                                                C.@upcoming.InstallmentNumber: @upcoming.DueDate.ToString("dd/MM") (@upcoming.Amount.ToString("N2") €)
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="d-flex flex-column-reverse flex-sm-row gap-2 pt-2.5 border-top">
                                <button class="btn btn-outline-secondary py-2 rounded-pill d-flex justify-content-center align-items-center gap-1.5 w-100 w-sm-auto small"
                                        @onclick="() => DeleteInstallment(item.Id)">
                                    <Icon Name="trash" Size="14" /> <span>Eliminar</span>
                                </button>
                                @if (!item.IsCompleted)
                                {
                                    <button class="btn btn-dark rounded-pill py-2 shadow-xs d-flex justify-content-center align-items-center gap-1.5 w-100 w-sm-auto small font-medium"
                                            @onclick="() => PayNext(item.Id)">
                                        <Icon Name="check" Size="14" />
                                        <span>Pagar Cuota @(item.PaidInstallments + 1) (@item.InstallmentAmount.ToString("N2") €)</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border px-3 py-1.5 align-self-center fs-xs">Totalmente pagado</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- MODAL NUEVA COMPRA EN CUOTAS -->
<ModalDialog IsOpen="isModalOpen" Title="Registrar Compra en Cuotas" OnClose="CloseModal">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label small fw-semibold">Concepto / Compra</label>
                <input type="text" class="form-control" @bind="newItem.Concept" placeholder="Ej. Viaje Argentina, MacBook Pro..." />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Categoría</label>
                <select class="form-select" @bind="newItem.Category">
                    <option value="Ocio">Ocio</option>
                    <option value="Equipamiento">Equipamiento</option>
                    <option value="Transporte">Transporte</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Importe Total (€)</label>
                <input type="number" step="0.01" class="form-control" @bind="newItem.TotalAmount" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Número Total de Cuotas</label>
                <input type="number" class="form-control" @bind="newItem.TotalInstallments" min="1" max="60" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Cuotas Ya Pagadas</label>
                <input type="number" class="form-control" @bind="newItem.PaidInstallments" min="0" max="@newItem.TotalInstallments" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold">Fecha Primera Cuota</label>
                <input type="date" class="form-control" @bind="newItem.StartDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold">Fecha Siguiente Cuota</label>
                <input type="date" class="form-control" @bind="newItem.NextDueDate" />
            </div>
            <div class="col-12 bg-light p-3 rounded-3">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Importe calculado por cuota:</span>
                    <strong class="text-primary fs-5">@newItem.InstallmentAmount.ToString("N2") € / mes</strong>
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="CloseModal">Cancelar</button>
        <button class="btn btn-primary" @onclick="SaveInstallment">Guardar Cuotas</button>
    </Footer>
</ModalDialog>

@code {
    private bool isModalOpen = false;
    private InstallmentPurchase newItem = new();

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private void OpenAddModal()
    {
        newItem = new InstallmentPurchase
        {
            TotalInstallments = 6,
            PaidInstallments = 0,
            StartDate = DateTime.Today,
            NextDueDate = DateTime.Today.AddMonths(1)
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveInstallment()
    {
        if (string.IsNullOrWhiteSpace(newItem.Concept) || newItem.TotalAmount <= 0 || newItem.TotalInstallments <= 0) return;
        await AppState.AddInstallmentAsync(newItem);
        isModalOpen = false;
    }

    private async Task PayNext(string id)
    {
        await AppState.PayNextInstallmentAsync(id);
    }

    private async Task DeleteInstallment(string id)
    {
        await AppState.DeleteInstallmentAsync(id);
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
