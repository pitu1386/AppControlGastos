@page "/cuotas"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-installments-view p-3">
    <!-- Encabezado Móvil Limpio -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h5 fw-bold text-slate-900 m-0">Gastos a Plazos & Cuotas</h1>
            <p class="text-muted fs-xs m-0">Compras financiadas y compromisos futuros</p>
        </div>
        <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-xs d-flex align-items-center gap-1.5" @onclick="OpenAddModal">
            <Icon Name="plus" Size="14" />
            <span>Nueva Cuota</span>
        </button>
    </div>

    <!-- TARJETA DESTACADA: DINERO COMPROMETIDO A FUTURO -->
    @{
        var activeInstallments = AppState.Data.Installments.Where(i => !i.IsCompleted).ToList();
        var completedInstallments = AppState.Data.Installments.Where(i => i.IsCompleted).ToList();
    }
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm">
        <div class="card-body p-3.5">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
                <span class="fs-xs text-uppercase tracking-wider text-slate-400 fw-bold">Dinero Comprometido a Futuro</span>
                <span class="badge fs-xs rounded-pill" style="background-color: var(--pastel-danger-bg) !important; color: var(--pastel-danger-text) !important; border: 1px solid var(--pastel-danger-border) !important;">
                    @activeInstallments.Count compras en curso
                </span>
            </div>

            <div class="d-flex align-items-baseline justify-content-between my-1">
                <div class="financial-display-amount fw-bold tracking-tight text-white">
                    @AppState.Data.TotalCommittedFutureInstallments.ToString("N2") €
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2.5 pt-2 border-top border-slate-700 fs-xs">
                <span class="text-slate-400">
                    Impacto este mes: <strong class="text-white">@AppState.Data.NextInstallmentsDueThisMonth.ToString("N2") €</strong>
                </span>
                <span class="text-slate-400">
                    Amortizado: <strong class="text-slate-300">@AppState.Data.Installments.Sum(i => i.PaidAmount).ToString("N2") €</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS: ACTIVAS vs FINALIZADAS -->
    <div class="segmented-control mb-3">
        <button type="button" class="segmented-item @(activeTab == "activas" ? "active" : "")" @onclick='() => activeTab = "activas"'>
            En Curso (@activeInstallments.Count)
        </button>
        <button type="button" class="segmented-item @(activeTab == "finalizadas" ? "active" : "")" @onclick='() => activeTab = "finalizadas"'>
            Completadas (@completedInstallments.Count)
        </button>
    </div>

    <!-- LISTADO SEGÚN PESTAÑA -->
    @if (activeTab == "activas")
    {
        @if (!activeInstallments.Any())
        {
            <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
                <Icon Name="credit-card" Size="28" Class="text-muted opacity-50 mb-2" />
                <div class="fw-bold text-slate-800 small">No tienes cuotas pendientes</div>
                <p class="text-muted fs-xs mb-3">¡Excelente! No tienes pagos fraccionados ni compromisos futuros de compras.</p>
                <div>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenAddModal">
                        + Registrar compra financiada
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var item in activeInstallments)
                {
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
                        <div class="p-3">
                            <!-- Cabecera de la tarjeta de compra -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="category-icon-bubble">
                                        @GetCategoryIcon(item.Category)
                                    </div>
                                    <div>
                                        <div class="fw-bold text-slate-900 small">@item.Concept</div>
                                        <div class="d-flex align-items-center gap-1.5 mt-0.5">
                                            <span class="badge bg-light text-secondary border fs-xs">@item.Category</span>
                                            <span class="badge bg-light text-muted border fs-xs">@item.Scope</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge rounded-pill bg-light text-dark border px-2 py-1 fs-xs">
                                        Cuota @item.PaidInstallments de @item.TotalInstallments
                                    </span>
                                </div>
                            </div>

                            <!-- Métricas principales -->
                            <div class="row g-2 my-2 py-2 border-top border-bottom border-slate-100">
                                <div class="col-4">
                                    <span class="fs-xs text-muted d-block">Cuota / mes</span>
                                    <strong class="text-slate-900 fs-6">@item.InstallmentAmount.ToString("N2") €</strong>
                                </div>
                                <div class="col-4 text-center">
                                    <span class="fs-xs text-muted d-block">Pendiente</span>
                                    <strong class="text-danger fs-6">@item.CommittedFutureAmount.ToString("N2") €</strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="fs-xs text-muted d-block">Total Compra</span>
                                    <strong class="text-slate-900 fs-6">@item.TotalAmount.ToString("N2") €</strong>
                                </div>
                            </div>

                            <!-- Barra de progreso de amortización -->
                            <div class="my-2">
                                <div class="d-flex justify-content-between fs-xs text-muted mb-1">
                                    <span>Progreso amortizado</span>
                                    <span>@((int)((double)item.PaidInstallments / item.TotalInstallments * 100))%</span>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 3px; background-color: var(--color-slate-100);">
                                    <div class="progress-bar bg-dark" role="progressbar" 
                                         style="width: @((double)item.PaidInstallments / item.TotalInstallments * 100)%;">
                                    </div>
                                </div>
                            </div>

                            <!-- Próximos vencimientos proyectados -->
                            <div class="bg-light p-2 rounded-2 mt-2.5 mb-2.5">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fs-xs fw-semibold text-muted text-uppercase">Próximo Vencimiento</span>
                                    <span class="fs-xs fw-bold text-slate-800 font-monospace">@item.NextDueDate.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var upcoming in item.GetUpcomingInstallments().Take(3))
                                    {
                                        <span class="badge bg-white text-dark border px-2 py-0.5 fs-xs font-monospace">
                                            C.@upcoming.InstallmentNumber: @upcoming.DueDate.ToString("dd/MM") • @upcoming.Amount.ToString("N0") €
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Acciones táctiles móviles -->
                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fs-xs d-flex align-items-center gap-1"
                                        @onclick="() => DeleteInstallment(item.Id)">
                                    <Icon Name="trash" Size="13" />
                                    <span>Eliminar</span>
                                </button>
                                <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-xs fs-xs d-flex align-items-center gap-1 font-medium"
                                        @onclick="() => PayNext(item.Id)">
                                    <Icon Name="check" Size="13" />
                                    <span>Pagar Cuota @(item.PaidInstallments + 1) (@item.InstallmentAmount.ToString("N2") €)</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @if (!completedInstallments.Any())
        {
            <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
                <Icon Name="check-circle" Size="28" Class="text-muted opacity-50 mb-2" />
                <div class="fw-bold text-slate-800 small">Sin compras finalizadas</div>
                <p class="text-muted fs-xs mb-0">Cuando termines de pagar todas las cuotas de una compra, se archivará aquí.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var item in completedInstallments)
                {
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white opacity-85">
                        <div class="p-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="category-icon-bubble bg-light">
                                        @GetCategoryIcon(item.Category)
                                    </div>
                                    <div>
                                        <div class="fw-bold text-slate-900 small">@item.Concept</div>
                                        <span class="fs-xs text-muted">@item.Category • @item.Scope</span>
                                    </div>
                                </div>
                                <span class="badge rounded-pill" style="background-color: var(--pastel-success-bg); color: var(--pastel-success-text); border: 1px solid var(--pastel-success-border);">
                                    Totalmente pagado
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-slate-50 fs-xs text-muted">
                                <span>Amortizadas: @item.TotalInstallments de @item.TotalInstallments cuotas</span>
                                <strong class="text-slate-900">Total: @item.TotalAmount.ToString("N2") €</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- MODAL NUEVA COMPRA EN CUOTAS -->
<ModalDialog IsOpen="isModalOpen" Title="Registrar Compra en Cuotas" OnClose="CloseModal">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Concepto / Compra</label>
                <input type="text" class="form-control" @bind="newItem.Concept" placeholder="Ej. MacBook Pro, Viaje Argentina..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Categoría</label>
                <select class="form-select" @bind="newItem.Category">
                    <option value="Equipamiento">Equipamiento</option>
                    <option value="Ocio">Ocio</option>
                    <option value="Transporte">Transporte</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Importe Total (€)</label>
                <input type="number" step="0.01" class="form-control" @bind="newItem.TotalAmount" />
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Nº Total de Cuotas</label>
                <input type="number" class="form-control" @bind="newItem.TotalInstallments" min="1" max="60" />
            </div>
            <div class="col-md-4">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Cuotas Ya Pagadas</label>
                <input type="number" class="form-control" @bind="newItem.PaidInstallments" min="0" max="@newItem.TotalInstallments" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Fecha Primera Cuota</label>
                <input type="date" class="form-control" @bind="newItem.StartDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Fecha Próxima Cuota</label>
                <input type="date" class="form-control" @bind="newItem.NextDueDate" />
            </div>
            <div class="col-12 bg-light p-2.5 rounded-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted fs-xs">Cuota mensual calculada:</span>
                    <strong class="text-slate-900 fs-6">@newItem.InstallmentAmount.ToString("N2") € / mes</strong>
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="CloseModal">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveInstallment">Guardar Cuotas</button>
    </Footer>
</ModalDialog>

@code {
    private string activeTab = "activas";
    private bool isModalOpen = false;
    private InstallmentPurchase newItem = new();

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private string GetCategoryIcon(string category) => category switch
    {
        "Equipamiento" => "💻",
        "Ocio" => "✈️",
        "Transporte" => "🚗",
        _ => "📦"
    };

    private void OpenAddModal()
    {
        newItem = new InstallmentPurchase
        {
            TotalInstallments = 6,
            PaidInstallments = 0,
            StartDate = DateTime.Today,
            NextDueDate = DateTime.Today.AddMonths(1),
            Category = "Equipamiento"
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveInstallment()
    {
        if (string.IsNullOrWhiteSpace(newItem.Concept) || newItem.TotalAmount <= 0 || newItem.TotalInstallments <= 0) return;
        await AppState.AddInstallmentAsync(newItem);
        isModalOpen = false;
    }

    private async Task PayNext(string id)
    {
        await AppState.PayNextInstallmentAsync(id);
    }

    private async Task DeleteInstallment(string id)
    {
        await AppState.DeleteInstallmentAsync(id);
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
