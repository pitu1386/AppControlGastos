@page "/ahorro"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-savings-view p-3">
    <!-- CABECERA MÓVIL IMPECCABLE -->
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">🎯</span>
                <h1 class="h5 fw-bold text-slate-900 m-0">Objetivos de Ahorro & Huchas</h1>
            </div>
            <p class="fs-xs text-muted m-0 mt-1">
                Fija tu meta mensual y distribuye fondos en huchas independientes.
            </p>
        </div>
        <button class="btn btn-dark btn-sm rounded-pill px-3 shadow-xs d-flex align-items-center gap-1 flex-shrink-0" style="min-height: 38px;" @onclick="OpenAddJarModal">
            <Icon Name="plus" Size="14" />
            <span>Nueva Hucha</span>
        </button>
    </div>

    @{
        decimal monthlyTarget = AppState.Data.SavingsConfig.MonthlySavingsTarget;
        decimal monthAvailableForSavings = Math.Max(0m, AppState.Data.CurrentMonthProfit);
        decimal savingsShortfall = Math.Max(0m, monthlyTarget - monthAvailableForSavings);
        decimal complianceRatio = monthlyTarget > 0 ? Math.Min(100m, Math.Round((monthAvailableForSavings / monthlyTarget) * 100m, 1)) : 0m;
        decimal totalJarsAmount = AppState.Data.SavingsConfig.Jars.Sum(j => j.CurrentAmount);
    }

    <!-- HERO CARD DARK: CAPACIDAD Y CUMPLIMIENTO -->
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm" style="background: linear-gradient(145deg, #18181b 0%, #27272a 100%); color: #ffffff; border-radius: 16px; border: 1px solid #3f3f46;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="fs-xs text-uppercase tracking-wider fw-semibold" style="color: #a1a1aa;">
                    Capacidad Ahorrada Mes
                </span>
                <button class="btn btn-xs rounded-pill px-2 py-1 text-white border-0" style="background: rgba(255,255,255,0.12); font-size: 11px;" @onclick="OpenConfigTargetModal">
                    ⚙️ Meta: @monthlyTarget.ToString("N0") €/mes
                </button>
            </div>

            <div class="d-flex align-items-baseline gap-2 my-2">
                <h2 class="fs-2 fw-bold text-white mb-0">@monthAvailableForSavings.ToString("N2") €</h2>
                <span class="badge" style="@(complianceRatio >= 100 ? "background: rgba(16, 185, 129, 0.25); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.4);" : "background: rgba(59, 130, 246, 0.25); color: #93c5fd; border: 1px solid rgba(59, 130, 246, 0.4);")">
                    @complianceRatio% logrado
                </span>
            </div>

            <!-- Progreso mensual sutil -->
            <div class="w-100 my-2" style="height: 6px; background: rgba(255, 255, 255, 0.15); border-radius: 999px; overflow: hidden;">
                <div style="height: 100%; width: @complianceRatio%; background: @(complianceRatio >= 100 ? "#10b981" : "#38bdf8"); border-radius: 999px; transition: width 0.3s ease;"></div>
            </div>

            <div class="row g-2 pt-2 border-top border-secondary border-opacity-25 mt-2">
                <div class="col-4">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">Objetivo</span>
                    <span class="fs-sm fw-bold text-white">@monthlyTarget.ToString("N0") €</span>
                </div>
                <div class="col-4">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">Falta</span>
                    <span class="fs-sm fw-bold @(savingsShortfall > 0 ? "text-amber-400" : "text-emerald-400")" style="@(savingsShortfall > 0 ? "color: #fbbf24;" : "color: #34d399;")">
                        @(savingsShortfall > 0 ? savingsShortfall.ToString("N0") + " €" : "Cubierto")
                    </span>
                </div>
                <div class="col-4 text-end">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">En Huchas</span>
                    <span class="fs-sm fw-bold text-white">@totalJarsAmount.ToString("N0") €</span>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN DE HUCHAS ACTIVAS -->
    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <span class="fs-xs fw-bold text-uppercase tracking-wider text-muted">
            Huchas & Fondos Temáticos (@AppState.Data.SavingsConfig.Jars.Count)
        </span>
        <span class="fs-xs text-muted">Total: @totalJarsAmount.ToString("N2") €</span>
    </div>

    @if (!AppState.Data.SavingsConfig.Jars.Any())
    {
        <div class="card border rounded-3 p-4 text-center bg-white shadow-xs my-3">
            <span class="fs-1 d-block mb-2">🏺</span>
            <h6 class="fw-bold text-slate-800 mb-1">No tienes huchas creadas</h6>
            <p class="fs-xs text-muted mb-3">
                Crea una hucha para separar dinero para vacaciones, entrada de vivienda o proyectos.
            </p>
            <div>
                <button class="btn btn-sm btn-dark rounded-pill px-3" @onclick="OpenAddJarModal">
                    + Crear Primera Hucha
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2 mb-4">
            @foreach (var jar in AppState.Data.SavingsConfig.Jars)
            {
                decimal jarRatio = jar.TargetAmount > 0 ? Math.Min(100m, Math.Round((jar.CurrentAmount / jar.TargetAmount) * 100m, 1)) : 0m;
                bool isCompleted = jar.CurrentAmount >= jar.TargetAmount && jar.TargetAmount > 0;

                <div class="card border rounded-3 p-3 bg-white shadow-xs">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2" style="min-width: 0;">
                            <div class="category-icon-bubble flex-shrink-0" style="width: 36px; height: 36px; border-radius: 10px; background: var(--pastel-indigo-bg); color: var(--pastel-indigo-text); display: flex; align-items: center; justify-content: center; font-size: 16px;">
                                @GetJarEmoji(jar.Name)
                            </div>
                            <div class="text-truncate">
                                <span class="fw-bold text-slate-900 fs-sm d-block text-truncate">@jar.Name</span>
                                <span class="fs-xs text-muted">Meta: @jar.TargetAmount.ToString("N2") €</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <span class="badge @(isCompleted ? "badge-pastel-success" : "badge-pastel-info") fs-xs">
                                @(isCompleted ? "✓ Conseguido" : $"{jarRatio}%")
                            </span>
                            <button class="btn btn-sm btn-link text-muted p-1" style="min-height: 32px;" title="Eliminar hucha" @onclick="() => DeleteJar(jar.Id)">
                                <Icon Name="trash" Size="14" />
                            </button>
                        </div>
                    </div>

                    <!-- Importe actual y progreso -->
                    <div class="d-flex justify-content-between align-items-baseline mt-2">
                        <span class="fs-5 fw-bold text-slate-900">@jar.CurrentAmount.ToString("N2") €</span>
                        <span class="fs-xs text-muted">de @jar.TargetAmount.ToString("N2") €</span>
                    </div>

                    <div class="w-100 my-2" style="height: 6px; background: #f1f5f9; border-radius: 999px; overflow: hidden;">
                        <div style="height: 100%; width: @jarRatio%; background: @(isCompleted ? "#10b981" : "#6366f1"); border-radius: 999px; transition: width 0.3s ease;"></div>
                    </div>

                    <!-- Botones de aportación rápida -->
                    <div class="d-flex gap-2 mt-2 pt-2 border-top">
                        <button class="btn btn-xs btn-outline-secondary rounded-pill flex-fill py-1" style="min-height: 34px; font-size: 12px;" @onclick="() => QuickAddSavings(jar, 50)">
                            +50 €
                        </button>
                        <button class="btn btn-xs btn-outline-success rounded-pill flex-fill py-1 fw-semibold" style="min-height: 34px; font-size: 12px;" @onclick="() => QuickAddSavings(jar, 100)">
                            +100 €
                        </button>
                        <button class="btn btn-xs btn-outline-primary rounded-pill flex-fill py-1" style="min-height: 34px; font-size: 12px;" @onclick="() => QuickAddSavings(jar, 250)">
                            +250 €
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- MODAL AJUSTAR META MENSUAL -->
<ModalDialog IsOpen="isConfigModalOpen" Title="Objetivo Mensual de Ahorro" OnClose="() => isConfigModalOpen = false">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label fs-xs fw-semibold text-muted text-uppercase">¿Cuánto te gustaría ahorrar cada mes? (€)</label>
            <input type="number" step="50" class="form-control fw-bold" style="min-height: 44px; font-size: 18px;" @bind="tempMonthlyTarget" />
        </div>
        <p class="fs-xs text-muted m-0">
            Esta meta se utilizará en el informe mensual y en el panel principal para evaluar el ahorro conseguido tras cubrir impuestos, gastos y reservas obligatorias.
        </p>
    </ChildContent>
    <Footer>
        <button class="btn btn-light rounded-pill px-3" style="min-height: 40px;" @onclick="() => isConfigModalOpen = false">Cancelar</button>
        <button class="btn btn-dark rounded-pill px-4" style="min-height: 40px;" @onclick="SaveMonthlyTarget">Guardar Meta</button>
    </Footer>
</ModalDialog>

<!-- MODAL NUEVA HUCHA -->
<ModalDialog IsOpen="isJarModalOpen" Title="Crear Nueva Hucha / Fondo" OnClose="() => isJarModalOpen = false">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Nombre de la Hucha</label>
                <input type="text" class="form-control" style="min-height: 44px;" @bind="newJar.Name" placeholder="Ej. Vacaciones, Entrada Piso, Emergencia..." />
            </div>
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Saldo Inicial (€)</label>
                <input type="number" step="25" class="form-control" style="min-height: 44px;" @bind="newJar.CurrentAmount" />
            </div>
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Meta Objetivo (€)</label>
                <input type="number" step="100" class="form-control" style="min-height: 44px;" @bind="newJar.TargetAmount" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light rounded-pill px-3" style="min-height: 40px;" @onclick="() => isJarModalOpen = false">Cancelar</button>
        <button class="btn btn-dark rounded-pill px-4" style="min-height: 40px;" @onclick="SaveJar">Guardar Hucha</button>
    </Footer>
</ModalDialog>

@code {
    private bool isConfigModalOpen = false;
    private decimal tempMonthlyTarget = 500m;

    private bool isJarModalOpen = false;
    private SavingsJar newJar = new();

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private string GetJarEmoji(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "🏺";
        var lower = name.ToLower();
        if (lower.Contains("viaje") || lower.Contains("vuelo") || lower.Contains("vacacion")) return "✈️";
        if (lower.Contains("casa") || lower.Contains("piso") || lower.Contains("hipoteca") || lower.Contains("vivienda")) return "🏠";
        if (lower.Contains("coche") || lower.Contains("auto") || lower.Contains("moto")) return "🚗";
        if (lower.Contains("emergencia") || lower.Contains("colchon") || lower.Contains("seguridad")) return "🛡️";
        if (lower.Contains("impuesto") || lower.Contains("hacienda") || lower.Contains("tributo")) return "📑";
        if (lower.Contains("boda") || lower.Contains("fiesta")) return "💍";
        if (lower.Contains("estudio") || lower.Contains("master") || lower.Contains("curso")) return "🎓";
        return "🎯";
    }

    private void OpenConfigTargetModal()
    {
        tempMonthlyTarget = AppState.Data.SavingsConfig.MonthlySavingsTarget;
        isConfigModalOpen = true;
    }

    private async Task SaveMonthlyTarget()
    {
        if (tempMonthlyTarget <= 0) return;
        await AppState.SetSavingsMonthlyTargetAsync(tempMonthlyTarget);
        isConfigModalOpen = false;
    }

    private void OpenAddJarModal()
    {
        newJar = new SavingsJar { TargetAmount = 1000m, CurrentAmount = 0m };
        isJarModalOpen = true;
    }

    private async Task SaveJar()
    {
        if (string.IsNullOrWhiteSpace(newJar.Name)) return;
        await AppState.AddOrUpdateJarAsync(newJar);
        isJarModalOpen = false;
    }

    private async Task QuickAddSavings(SavingsJar jar, decimal addAmount)
    {
        jar.CurrentAmount += addAmount;
        await AppState.AddOrUpdateJarAsync(jar);
    }

    private async Task DeleteJar(string id)
    {
        await AppState.DeleteJarAsync(id);
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
