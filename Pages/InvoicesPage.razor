@page "/facturas"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-invoices-view p-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h5 fw-bold text-slate-900 m-0">Facturación & Cobros</h1>
            <p class="text-muted fs-xs m-0">Nacionales, Bélgica (UE), IRPF y plazos a 90 días</p>
        </div>
        <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-xs d-flex align-items-center gap-1" @onclick="OpenAddModal">
            <Icon Name="plus" Size="14" />
            <span>Emitir</span>
        </button>
    </div>

    <!-- TARJETAS RESUMEN COMPACTAS MÓVILES -->
    <div class="row g-2 mb-3">
        <div class="col-6">
            <div class="card p-2 bg-white rounded-3">
                <span class="fs-xs text-muted fw-semibold">Pendiente Cobro</span>
                <div class="fw-bold text-warning fs-6">@AppState.Data.TotalPendingInvoices.ToString("N2") €</div>
                <div class="fs-xs text-muted">@AppState.Data.Invoices.Count(i => !i.IsCollected) pendientes</div>
            </div>
        </div>
        <div class="col-6">
            <div class="card p-2 bg-white rounded-3">
                <span class="fs-xs text-muted fw-semibold">Ya Cobrado</span>
                <div class="fw-bold text-success fs-6">
                    @AppState.Data.Invoices.Where(i => i.IsCollected).Sum(i => i.CollectedAmount > 0 ? i.CollectedAmount : i.TotalInvoice).ToString("N2") €
                </div>
                <div class="fs-xs text-muted">Entrado en banco</div>
            </div>
        </div>
        <div class="col-12">
            <div class="card p-2 bg-white rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fs-xs text-muted fw-semibold">Reservas Fiscales IRPF Exterior</span>
                        <div class="fw-bold text-dark fs-6">
                            @AppState.Data.Invoices.Where(i => i.MustReserveIrpfExternally).Sum(i => i.IrpfReserveAmount).ToString("N2") €
                        </div>
                    </div>
                    <span class="badge bg-light text-muted border fs-xs">Para Modelo 130</span>
                </div>
            </div>
        </div>
    </div>

    <!-- BUSCADOR Y FILTROS RÁPIDOS -->
    <div class="d-flex gap-2 mb-3">
        <input type="text" class="form-control form-control-sm" placeholder="Buscar cliente o número..." @bind="searchTerm" @bind:event="oninput" />
        <select class="form-select form-select-sm w-auto" @bind="selectedFilterStatus">
            <option value="todos">Todos</option>
            <option value="pendientes">Pendientes</option>
            <option value="cobradas">Cobradas</option>
        </select>
    </div>

    <!-- LISTA DE FACTURAS EN FORMATO TARJETA MÓVIL -->
    <div class="d-flex flex-column gap-2 mb-4">
        @if (!FilteredInvoices.Any())
        {
            <div class="card shadow-sm border-0 p-5 text-center text-muted">
                <div class="fs-1 mb-2 opacity-25">🧾</div>
                <p class="fw-semibold text-slate-800 mb-1 small">Sin facturas con estos filtros</p>
                <p class="mb-3 fs-xs">Emite una factura para registrar tus cobros y calcular las reservas de IRPF automáticamente.</p>
                <button class="btn btn-primary rounded-pill px-4" @onclick="OpenAddModal">Emitir nueva factura</button>
            </div>
        }
        else
        {
            @foreach (var inv in FilteredInvoices)
            {
                <div class="card shadow-xs border-0 p-3 bg-white rounded-3 @(inv.IsOverdue ? "border-start border-3 border-danger" : (inv.IsCollected ? "border-start border-3 border-success" : "border-start border-3 border-warning"))">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <div>
                            <div class="fw-bold text-slate-900 small">@inv.ClientName</div>
                            <span class="fs-xs text-muted font-monospace">@inv.Number</span>
                            <span class="badge @(inv.Type == InvoiceType.Intracomunitaria || inv.Type == InvoiceType.Exterior ? "bg-info-subtle text-info border" : "bg-secondary-subtle text-secondary") fs-xs ms-1">
                                @inv.ClientCountry
                            </span>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold fs-6 @(inv.IsCollected ? "text-success" : "text-dark")">
                                @inv.TotalInvoice.ToString("N2") €
                            </div>
                            <span class="badge @(inv.IsCollected ? "bg-success-subtle text-success border" : "bg-warning-subtle text-warning border") fs-xs">
                                @(inv.IsCollected ? "Cobrada" : "Pendiente")
                            </span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top fs-xs text-muted">
                        <div>
                            <span>Emisión: @inv.IssueDate.ToString("dd/MM/yy")</span>
                            <span class="ms-2">Previsto: @inv.ExpectedPaymentDate.ToString("dd/MM/yy")</span>
                        </div>
                        @if (inv.MustReserveIrpfExternally)
                        {
                            <span class="text-warning fw-semibold">Reserva IRPF: -@inv.IrpfReserveAmount.ToString("N0") €</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2 pt-1">
                        <div>
                            @if (!inv.IsCollected)
                            {
                                @if (inv.IsOverdue)
                                {
                                    <span class="badge bg-danger fs-xs">Retraso (-@Math.Abs(inv.DaysUntilPayment) días)</span>
                                }
                                else
                                {
                                    <span class="fs-xs text-muted">En @inv.DaysUntilPayment días</span>
                                }
                            }
                            else if (inv.CollectedDate.HasValue)
                            {
                                <span class="fs-xs text-success">Cobrada el @inv.CollectedDate.Value.ToString("dd/MM/yy")</span>
                            }
                        </div>
                        <div class="d-flex gap-1">
                            @if (!inv.IsCollected)
                            {
                                <button class="btn btn-xs btn-outline-success rounded-pill px-2 py-1 fs-xs" @onclick="() => MarkAsCollected(inv)">
                                    Cobrada
                                </button>
                            }
                            <button class="btn btn-xs btn-outline-danger rounded-pill px-2 py-1 fs-xs" @onclick="() => DeleteInvoice(inv.Id)">
                                <Icon Name="trash" Size="12" />
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- MODAL EMITIR FACTURA -->
<ModalDialog IsOpen="isModalOpen" Title="Emitir Factura" OnClose="() => isModalOpen = false">
    <ChildContent>
        <div class="row g-2">
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold">Número Factura</label>
                <input type="text" class="form-control form-control-sm" @bind="editingInvoice.Number" />
            </div>
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold">Cliente</label>
                <input type="text" class="form-control form-control-sm" @bind="editingInvoice.ClientName" />
            </div>
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold">País Cliente</label>
                <input type="text" class="form-control form-control-sm" @bind="editingInvoice.ClientCountry" />
            </div>
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold">Tipo</label>
                <select class="form-select form-select-sm" @bind="editingInvoice.Type" @bind:after="OnTypeChanged">
                    <option value="@InvoiceType.Nacional">Nacional (España)</option>
                    <option value="@InvoiceType.Intracomunitaria">Intracomunitaria (Bélgica / UE)</option>
                    <option value="@InvoiceType.Exterior">Exterior (Otros países)</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold">Base Imponible (€)</label>
                <input type="number" step="0.01" class="form-control form-control-sm" @bind="editingInvoice.BaseAmount" />
            </div>
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold">Plazo Cobro</label>
                <select class="form-select form-select-sm" @onchange="OnTermChanged">
                    <option value="30">30 días</option>
                    <option value="60">60 días</option>
                    <option value="90">90 días (Bélgica/plazos largos)</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold">Fecha Emisión</label>
                <input type="date" class="form-control form-control-sm" @bind="editingInvoice.IssueDate" />
            </div>
            <div class="col-6">
                <label class="form-label fs-xs fw-semibold">Fecha Prevista</label>
                <input type="date" class="form-control form-control-sm" @bind="editingInvoice.ExpectedPaymentDate" />
            </div>

            @if (editingInvoice.Type == InvoiceType.Nacional)
            {
                <div class="col-6">
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="mInvVat" @bind="editingInvoice.ApplyVat" />
                        <label class="form-check-label fs-xs" for="mInvVat">IVA 21%</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="mInvIrpf" @bind="editingInvoice.ApplyIrpfWithholding" />
                        <label class="form-check-label fs-xs" for="mInvIrpf">Retención IRPF 15%</label>
                    </div>
                </div>
            }
            else
            {
                <div class="col-12 p-2 bg-light rounded-2 border fs-xs">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="mInvRes" @bind="editingInvoice.MustReserveIrpfExternally" />
                        <label class="form-check-label fw-semibold" for="mInvRes">
                            Reservar IRPF 20% para Mod 130
                        </label>
                    </div>
                    <small class="text-muted d-block mt-1">
                        Reserva estimada: <strong>@editingInvoice.IrpfReserveAmount.ToString("N2") €</strong> para impuestos trimestrales.
                    </small>
                </div>
            }

            <div class="col-12 bg-light p-2 rounded-2 text-end mt-2">
                <span class="fs-xs text-muted me-2">Total a percibir:</span>
                <strong class="text-dark fs-6">@editingInvoice.TotalInvoice.ToString("N2") €</strong>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light" @onclick="() => isModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-primary" @onclick="SaveInvoice">Guardar Factura</button>
    </Footer>
</ModalDialog>

<!-- MODAL COBRO FACTURA -->
<ModalDialog IsOpen="isCollectModalOpen" Title="Registrar Cobro" OnClose="() => isCollectModalOpen = false">
    <ChildContent>
        @if (selectedInvoiceForCollection != null)
        {
            <div class="fs-xs mb-2">
                Factura <strong>@selectedInvoiceForCollection.Number</strong> de <strong>@selectedInvoiceForCollection.ClientName</strong>.
            </div>
            <div class="mb-2">
                <label class="form-label fs-xs fw-semibold">Fecha de Cobro</label>
                <input type="date" class="form-control form-control-sm" @bind="collectionDate" />
            </div>
            <div class="mb-2">
                <label class="form-label fs-xs fw-semibold">Importe Cobrado (€)</label>
                <input type="number" step="0.01" class="form-control form-control-sm" @bind="collectionAmount" />
            </div>
            <div class="alert alert-info fs-xs p-2 m-0">
                Se sumará a tu saldo bancario disponible.
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light" @onclick="() => isCollectModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-success" @onclick="ConfirmCollection">Confirmar Cobro</button>
    </Footer>
</ModalDialog>

@code {
    private string searchTerm = "";
    private string selectedFilterStatus = "todos";

    private bool isModalOpen = false;
    private Invoice editingInvoice = new();

    private bool isCollectModalOpen = false;
    private Invoice? selectedInvoiceForCollection;
    private DateTime collectionDate = DateTime.Today;
    private decimal collectionAmount = 0;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private IEnumerable<Invoice> FilteredInvoices
    {
        get
        {
            var list = AppState.Data.Invoices.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                list = list.Where(i => i.ClientName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                       i.Number.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedFilterStatus == "pendientes")
            {
                list = list.Where(i => !i.IsCollected);
            }
            else if (selectedFilterStatus == "cobradas")
            {
                list = list.Where(i => i.IsCollected);
            }

            return list;
        }
    }

    private void OpenAddModal()
    {
        editingInvoice = new Invoice
        {
            Number = $"FAC-{DateTime.Today.Year}-{(AppState.Data.Invoices.Count + 1):D3}",
            IssueDate = DateTime.Today,
            ExpectedPaymentDate = DateTime.Today.AddDays(30)
        };
        isModalOpen = true;
    }

    private void OnTypeChanged()
    {
        if (editingInvoice.Type == InvoiceType.Intracomunitaria || editingInvoice.Type == InvoiceType.Exterior)
        {
            editingInvoice.ApplyVat = false;
            editingInvoice.ApplyIrpfWithholding = false;
            editingInvoice.MustReserveIrpfExternally = true;
            editingInvoice.ExternalIrpfReserveRate = 20m;
            editingInvoice.ExpectedPaymentDate = editingInvoice.IssueDate.AddDays(90);
        }
        else
        {
            editingInvoice.ApplyVat = true;
            editingInvoice.ApplyIrpfWithholding = true;
            editingInvoice.MustReserveIrpfExternally = false;
            editingInvoice.ExpectedPaymentDate = editingInvoice.IssueDate.AddDays(30);
        }
    }

    private void OnTermChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int days) && days > 0)
        {
            editingInvoice.ExpectedPaymentDate = editingInvoice.IssueDate.AddDays(days);
        }
    }

    private async Task SaveInvoice()
    {
        if (string.IsNullOrWhiteSpace(editingInvoice.Number) || editingInvoice.BaseAmount <= 0) return;
        await AppState.AddInvoiceAsync(editingInvoice);
        isModalOpen = false;
    }

    private void MarkAsCollected(Invoice inv)
    {
        selectedInvoiceForCollection = inv;
        collectionDate = DateTime.Today;
        collectionAmount = inv.PendingToCollect;
        isCollectModalOpen = true;
    }

    private async Task ConfirmCollection()
    {
        if (selectedInvoiceForCollection != null)
        {
            await AppState.MarkInvoiceCollectedAsync(selectedInvoiceForCollection.Id, collectionDate, collectionAmount);
            isCollectModalOpen = false;
        }
    }

    private async Task DeleteInvoice(string id)
    {
        await AppState.DeleteInvoiceAsync(id);
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
