@page "/salud-financiera"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-financial-health-view p-3">
    <!-- CABECERA MÓVIL IMPECCABLE -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">🧭</span>
                <h1 class="h5 fw-bold text-slate-900 m-0">Salud Financiera</h1>
            </div>
            <p class="fs-xs text-muted m-0 mt-1">
                La visión honesta: beneficio, liquidez, patrimonio y compromisos.
            </p>
        </div>
    </div>

    <!-- HERO CARD DARK: DISPONIBLE REAL -->
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm" style="background: linear-gradient(145deg, #18181b 0%, #27272a 100%); color: #ffffff; border-radius: 16px; border: 1px solid #3f3f46;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="fs-xs text-uppercase tracking-wider fw-semibold" style="color: #a1a1aa;">
                    Métrica de Oro: Disponible Real
                </span>
                <span class="badge" style="@(AppState.Data.RealAvailableCash >= 0 ? "background: rgba(16, 185, 129, 0.25); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.4);" : "background: rgba(239, 68, 68, 0.25); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.4);")">
                    @(AppState.Data.RealAvailableCash >= 0 ? "Solvente" : "Tensión de liquidez")
                </span>
            </div>

            <div class="d-flex align-items-baseline gap-2 my-2">
                <h2 class="fs-2 fw-bold text-white mb-0">@AppState.Data.RealAvailableCash.ToString("N2") €</h2>
            </div>

            <!-- Desglose de disponibilidad en tarjeta oscura -->
            <div class="row g-2 pt-2 border-top border-secondary border-opacity-25 mt-2">
                <div class="col-6">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">Saldo en banco</span>
                    <span class="fs-sm fw-bold text-white">+@AppState.Data.BankAccountBalance.ToString("N2") €</span>
                </div>
                <div class="col-6 text-end">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">Reservas fiscales</span>
                    <span class="fs-sm fw-bold text-rose-400" style="color: #f87171;">-@AppState.Data.TaxReservesRequired.ToString("N2") €</span>
                </div>
                <div class="col-6">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">Gastos fijos mes</span>
                    <span class="fs-sm fw-bold text-rose-400" style="color: #f87171;">-@AppState.Data.ImmediateFixedExpenses.ToString("N2") €</span>
                </div>
                <div class="col-6 text-end">
                    <span class="fs-xs d-block" style="color: #a1a1aa;">Cuotas / Deudas</span>
                    <span class="fs-sm fw-bold text-rose-400" style="color: #f87171;">-@((AppState.Data.NextInstallmentsDueThisMonth + AppState.Data.CalculatePartnerDebt() + AppState.Data.FundDebtPending + AppState.Data.ThirdPartyMoney).ToString("N2")) €</span>
                </div>
            </div>
        </div>
    </div>

    <!-- SEGMENTED CONTROL: 5 INDICADORES vs 5 TIPOS DE DINERO -->
    <div class="segmented-control mb-3">
        <button class="segmented-item @(activeTab == "indicators" ? "active" : "")" @onclick='() => activeTab = "indicators"'>
            5 Indicadores Clave
        </button>
        <button class="segmented-item @(activeTab == "types" ? "active" : "")" @onclick='() => activeTab = "types"'>
            5 Tipos de Dinero
        </button>
    </div>

    @if (activeTab == "indicators")
    {
        <!-- LOS 5 INDICADORES EN TARJETAS MÓVILES TÁCTILES -->
        <div class="d-flex flex-column gap-2 mb-3">
            <!-- 1. BENEFICIO -->
            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <div class="category-icon-bubble" style="width: 32px; height: 32px; border-radius: 8px; background: var(--pastel-indigo-bg); color: var(--pastel-indigo-text); display: flex; align-items: center; justify-content: center; font-size: 14px;">
                            📈
                        </div>
                        <span class="fs-xs fw-bold text-slate-800 text-uppercase">1. Beneficio del Mes</span>
                    </div>
                    <span class="fs-6 fw-bold text-slate-900">@AppState.Data.CurrentMonthProfit.ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0 mt-1">
                    Rendimiento real de tu actividad tras deducir impuestos y costes comerciales.
                </p>
            </div>

            <!-- 2. LIQUIDEZ -->
            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <div class="category-icon-bubble" style="width: 32px; height: 32px; border-radius: 8px; background: var(--pastel-success-bg); color: var(--pastel-success-text); display: flex; align-items: center; justify-content: center; font-size: 14px;">
                            🏦
                        </div>
                        <span class="fs-xs fw-bold text-slate-800 text-uppercase">2. Saldo Bancario</span>
                    </div>
                    <span class="fs-6 fw-bold text-slate-900">@AppState.Data.BankAccountBalance.ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0 mt-1">
                    Saldo inmediato en tu cuenta corriente antes de aplicar reservas obligatorias.
                </p>
            </div>

            <!-- 3. PENDIENTE DE COBRO -->
            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <div class="category-icon-bubble" style="width: 32px; height: 32px; border-radius: 8px; background: var(--pastel-warning-bg); color: var(--pastel-warning-text); display: flex; align-items: center; justify-content: center; font-size: 14px;">
                            ⏳
                        </div>
                        <span class="fs-xs fw-bold text-slate-800 text-uppercase">3. Cobro Pendiente</span>
                    </div>
                    <span class="fs-6 fw-bold text-slate-900">@AppState.Data.TotalPendingInvoices.ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0 mt-1">
                    Facturas emitidas pendientes de ingreso (incluye clientes de Bélgica a 90 días).
                </p>
            </div>

            <!-- 4. COMPROMISOS -->
            @{
                decimal commitments = AppState.Data.TaxReservesRequired + AppState.Data.ImmediateFixedExpenses + AppState.Data.TotalCommittedFutureInstallments + AppState.Data.FamilyLoanDebt;
            }
            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <div class="category-icon-bubble" style="width: 32px; height: 32px; border-radius: 8px; background: var(--pastel-danger-bg); color: var(--pastel-danger-text); display: flex; align-items: center; justify-content: center; font-size: 14px;">
                            🔒
                        </div>
                        <span class="fs-xs fw-bold text-slate-800 text-uppercase">4. Compromisos Totales</span>
                    </div>
                    <span class="fs-6 fw-bold text-rose-700">@commitments.ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0 mt-1">
                    Impuestos retenidos, fijos comprometidos, compras a plazos y préstamo familiar.
                </p>
            </div>

            <!-- 5. TRABAJO FUTURO -->
            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <div class="category-icon-bubble" style="width: 32px; height: 32px; border-radius: 8px; background: var(--pastel-info-bg); color: var(--pastel-info-text); display: flex; align-items: center; justify-content: center; font-size: 14px;">
                            💼
                        </div>
                        <span class="fs-xs fw-bold text-slate-800 text-uppercase">5. Trabajo Futuro</span>
                    </div>
                    <span class="fs-6 fw-bold text-slate-900">@AppState.Data.ProjectsPotentialIncome.ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0 mt-1">
                    Ingresos proyectados por horas pendientes en proyectos activos contratados.
                </p>
            </div>
        </div>
    }
    else
    {
        <!-- LOS 5 TIPOS DE DINERO -->
        <div class="d-flex flex-column gap-2 mb-3">
            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fs-xs fw-bold text-emerald-800 text-uppercase">1. Dinero Propio Libre</span>
                    <span class="fs-6 fw-bold text-emerald-700">@AppState.Data.RealAvailableCash.ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0">
                    Limpio de compromisos, reservas fiscales o deudas. Tu patrimonio líquido real.
                </p>
            </div>

            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fs-xs fw-bold text-slate-800 text-uppercase">2. Dinero Profesional</span>
                    <span class="fs-6 fw-bold text-slate-900">@AppState.Data.Invoices.Sum(i => i.TotalInvoice).ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0">
                    Volumen de ventas brutas de tu actividad comercial como freelance.
                </p>
            </div>

            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fs-xs fw-bold text-slate-800 text-uppercase">3. Dinero de Terceros</span>
                    <span class="fs-6 fw-bold text-slate-900">@AppState.Data.ThirdPartyMoney.ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0">
                    Fondos recibidos de familiares que estás custodiando o administrando. No puedes gastarlo.
                </p>
            </div>

            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                @{
                    decimal totalDebt = AppState.Data.FamilyLoanDebt + AppState.Data.FundDebtPending + Math.Max(0m, AppState.Data.CalculatePartnerDebt());
                }
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fs-xs fw-bold text-rose-800 text-uppercase">4. Dinero Prestado / Deudas</span>
                    <span class="fs-6 fw-bold text-danger">@totalDebt.ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0">
                    Préstamo de padres (@AppState.Data.FamilyLoanDebt.ToString("N2") €), deuda con el fondo (@AppState.Data.FundDebtPending.ToString("N2") €) y saldo con pareja.
                </p>
            </div>

            <div class="card border rounded-3 p-3 bg-white shadow-xs">
                @{
                    decimal totalReserved = AppState.Data.TaxReservesRequired + AppState.Data.ImmediateFixedExpenses + AppState.Data.TotalCommittedFutureInstallments;
                }
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fs-xs fw-bold text-amber-800 text-uppercase">5. Dinero Reservado</span>
                    <span class="fs-6 fw-bold text-amber-700">@totalReserved.ToString("N2") €</span>
                </div>
                <p class="fs-xs text-muted m-0">
                    Reservas fiscales de IRPF e IVA, gastos fijos periódicos y cuotas pendientes.
                </p>
            </div>
        </div>
    }
</div>

@code {
    private string activeTab = "indicators";

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
