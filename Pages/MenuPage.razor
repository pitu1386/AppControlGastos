@page "/menu"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-menu-container p-3">
    <div class="mb-3">
        <h1 class="h4 fw-bold text-slate-900 m-0">Menú de Herramientas</h1>
        <p class="text-muted small m-0 mt-1">Todos los módulos y funcionalidades de tu contabilidad.</p>
    </div>

    <!-- TARJETA RÁPIDA DE SALUD FINANCIERA (Dark Premium) -->
    <a href="salud-financiera" class="card hero-card-dark mb-3 text-decoration-none overflow-hidden">
        <div class="card-body p-3 d-flex justify-content-between align-items-center">
            <div>
                <span class="fs-xs text-uppercase tracking-wider fw-bold text-slate-400">Salud Financiera</span>
                <div class="h5 fw-bold text-white m-0">Los 5 Tipos de Dinero</div>
                <small class="text-slate-300 fs-xs">Disponible real: @AppState.Data.RealAvailableCash.ToString("N0") €</small>
            </div>
            <div class="menu-icon-pill" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); color: #ffffff;">
                <Icon Name="shield" Size="20" />
            </div>
        </div>
    </a>

    <!-- SECCIÓN 1: ACTIVIDAD PROFESIONAL -->
    <div class="menu-section-title text-uppercase text-muted fw-bold fs-xs mb-2">
        Actividad Profesional & Facturación
    </div>
    <div class="card shadow-sm border-0 mb-3 overflow-hidden">
        <div class="list-group list-group-flush">
            <a href="facturas" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="invoice" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Facturación & Cobros</div>
                        <div class="fs-xs text-muted">Bélgica, España, reservas IRPF y cobros a 90 días</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>

            <a href="proyectos" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="briefcase" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Proyectos & Calculadora (€/h)</div>
                        <div class="fs-xs text-muted">Horas facturables vs gestión y rentabilidad neta</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>

            <a href="gastos-fijos" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="repeat" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Gastos Fijos & Reservas</div>
                        <div class="fs-xs text-muted">Autónomos, gestoría, software y reservas mensuales</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>
        </div>
    </div>

    <!-- SECCIÓN 2: CONTROL Y DEUDAS -->
    <div class="menu-section-title text-uppercase text-muted fw-bold fs-xs mb-2">
        Gastos, Pareja y Fondos
    </div>
    <div class="card shadow-sm border-0 mb-3 overflow-hidden">
        <div class="list-group list-group-flush">
            <a href="gastos" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="expense" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Registro de Gastos</div>
                        <div class="fs-xs text-muted">Profesional, Personal y Compartido</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>

            <a href="gastos-compartidos" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="users" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Gastos con Pareja</div>
                        <div class="fs-xs text-muted">Aportes y saldo acumulado pendiente</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>

            <a href="cuotas" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="credit-card" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Compras en Cuotas</div>
                        <div class="fs-xs text-muted">Compras fraccionadas (Argentina 3 de 7)</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>

            <a href="presupuestos" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="tag" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Presupuestos Mensuales</div>
                        <div class="fs-xs text-muted">Techos por categoría con alertas</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>

            <a href="fondo-liquidez" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="shield" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Colchón de Liquidez</div>
                        <div class="fs-xs text-muted">Retiros temporales y reposición al cobrar</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>

            <a href="fondos-familia" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="globe" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Familia & Terceros (Multidivisa)</div>
                        <div class="fs-xs text-muted">Préstamo de padres (8.000 €) y divisas USD/ARS</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>

            <a href="ahorro" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="piggy-bank" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Objetivos de Ahorro</div>
                        <div class="fs-xs text-muted">Meta mensual (500 €) y huchas temáticas</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>
        </div>
    </div>

    <!-- SECCIÓN 3: INFORMES Y PREVISIÓN -->
    <div class="menu-section-title text-uppercase text-muted fw-bold fs-xs mb-2">
        Previsión & Cierres
    </div>
    <div class="card shadow-sm border-0 mb-3 overflow-hidden">
        <div class="list-group list-group-flush">
            <a href="prevision" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="calendar" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Previsión Próximos Meses</div>
                        <div class="fs-xs text-muted">Calendario Cash Flow a 6 meses con facturas pendientes</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>

            <a href="informes" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="chart" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Informe Mensual Automático</div>
                        <div class="fs-xs text-muted">Cierre mensual y beneficio contable vs real</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>
        </div>
    </div>

    <!-- SECCIÓN 4: AJUSTES -->
    <div class="card shadow-sm border-0 mb-4 overflow-hidden">
        <div class="list-group list-group-flush">
            <a href="configuracion" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="menu-icon-pill">
                        <Icon Name="settings" Size="18" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden pe-2">
                        <div class="fw-semibold text-slate-900 small">Ajustes & Respaldo JSON</div>
                        <div class="fs-xs text-muted">Saldo bancario, exportar/importar backup y demo</div>
                    </div>
                </div>
                <span class="text-muted small">&rarr;</span>
            </a>
        </div>
    </div>
</div>

<style>
    .menu-icon-pill {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
        flex-shrink: 0;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
