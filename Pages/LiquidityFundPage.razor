@page "/fondo-liquidez"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-liquidity-view p-3">
    <!-- Encabezado Móvil Limpio -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h5 fw-bold text-slate-900 m-0">Colchón de Liquidez</h1>
            <p class="text-muted fs-xs m-0">Respaldo ante retrasos de cobro (90 días)</p>
        </div>
        <div class="d-flex gap-1.5">
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 fs-xs d-flex align-items-center gap-1" 
                    @onclick="() => OpenMovementModal(FundMovementType.RetiroPorTensionLiquidez)">
                <Icon Name="arrow-up-right" Size="13" />
                <span>Retirar</span>
            </button>
            <button class="btn btn-sm btn-primary rounded-pill px-2.5 py-1 fs-xs d-flex align-items-center gap-1 shadow-xs" 
                    @onclick="() => OpenMovementModal(FundMovementType.Reposicion)">
                <Icon Name="plus" Size="13" />
                <span>Reponer</span>
            </button>
        </div>
    </div>

    <!-- TARJETA HERO: SALDO Y META DEL COLCHÓN -->
    @{
        var fund = AppState.Data.LiquidityFund;
        decimal usedPending = fund.RealUsedPending;
    }
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm">
        <div class="card-body p-3.5">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
                <span class="fs-xs text-uppercase tracking-wider text-slate-400 fw-bold">Saldo en Fondo de Emergencia</span>
                <span class="badge fs-xs rounded-pill" style="@(usedPending > 0 ? "background-color: var(--pastel-warning-bg); color: var(--pastel-warning-text); border: 1px solid var(--pastel-warning-border);" : "background-color: var(--pastel-success-bg); color: var(--pastel-success-text); border: 1px solid var(--pastel-success-border);")">
                    @(usedPending > 0 ? "En uso temporal" : "Colchón intacto")
                </span>
            </div>

            <div class="d-flex align-items-baseline justify-content-between my-1">
                <div class="financial-display-amount fw-bold tracking-tight text-white">
                    @fund.CurrentBalance.ToString("N2") € <span class="fs-6 fw-normal text-slate-300">/ @fund.TargetAmount.ToString("N0") €</span>
                </div>
            </div>

            <!-- Barra de progreso hacia la meta -->
            <div class="my-2">
                <div class="progress" style="height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.15);">
                    <div class="progress-bar bg-light" role="progressbar" style="width: @Math.Min(fund.CompletionPercentage, 100m)%;"></div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2.5 pt-2 border-top border-slate-700 fs-xs">
                <span class="text-slate-400">
                    Pendiente reponer: <strong class="@(usedPending > 0 ? "text-amber-300" : "text-slate-300")">@usedPending.ToString("N2") €</strong>
                </span>
                <span class="text-slate-400">
                    Cobertura: <strong class="text-white">@fund.CompletionPercentage%</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- LISTADO DE MOVIMIENTOS EN TARJETAS MÓVILES -->
    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <span class="fs-xs fw-bold text-muted text-uppercase tracking-wider">Historial de Movimientos</span>
        <span class="badge bg-light text-muted border fs-xs">@fund.Movements.Count registros</span>
    </div>

    @if (!fund.Movements.Any())
    {
        <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
            <Icon Name="shield" Size="28" Class="text-muted opacity-50 mb-2" />
            <div class="fw-bold text-slate-800 small">Sin movimientos registrados</div>
            <p class="text-muted fs-xs mb-3">Tu fondo no registra extracciones temporales ni reposiciones.</p>
            <div>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="() => OpenMovementModal(FundMovementType.Reposicion)">
                    + Añadir aportación
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4">
            <div class="divide-y">
                @foreach (var mov in fund.Movements.OrderByDescending(m => m.Date))
                {
                    <div class="p-3 border-bottom border-slate-100 hover-bg-light transition">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="category-icon-bubble">
                                    @(mov.Type == FundMovementType.RetiroPorTensionLiquidez ? "⚠️" : (mov.Type == FundMovementType.Reposicion ? "🔄" : "💰"))
                                </div>
                                <div>
                                    <div class="fw-bold text-slate-900 small">@mov.Reason</div>
                                    <div class="d-flex align-items-center gap-1.5 mt-0.5">
                                        <span class="badge rounded-pill fs-xs" style="@(mov.Type == FundMovementType.RetiroPorTensionLiquidez ? "background-color: var(--pastel-warning-bg); color: var(--pastel-warning-text); border: 1px solid var(--pastel-warning-border);" : "background-color: var(--pastel-success-bg); color: var(--pastel-success-text); border: 1px solid var(--pastel-success-border);")">
                                            @(mov.Type == FundMovementType.RetiroPorTensionLiquidez ? "Retiro temporal" : (mov.Type == FundMovementType.Reposicion ? "Reposición" : "Aporte"))
                                        </span>
                                        <span class="text-muted fs-xs">@mov.Date.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold fs-6 @(mov.Type == FundMovementType.RetiroPorTensionLiquidez ? "text-danger" : "text-emerald-700")">
                                    @(mov.Type == FundMovementType.RetiroPorTensionLiquidez ? "-" : "+")@mov.Amount.ToString("N2") €
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- MODAL MOVIMIENTO FONDO -->
<ModalDialog IsOpen="isModalOpen" Title="@modalTitle" OnClose="() => isModalOpen = false">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Importe (€)</label>
                <input type="number" step="0.01" class="form-control" @bind="movementAmount" />
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Fecha</label>
                <input type="date" class="form-control" @bind="movementDate" />
            </div>
            <div class="col-12">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Motivo / Justificación</label>
                <input type="text" class="form-control" @bind="movementReason" placeholder="Ej. Esperando cobro factura cliente X (vence en 30 días)..." />
            </div>
            <div class="col-12 text-muted fs-xs">
                @if (selectedType == FundMovementType.RetiroPorTensionLiquidez)
                {
                    <span>Este retiro reduce tu colchón pero <strong>no cuenta como pérdida</strong>: se anotará como deuda pendiente de reponer.</span>
                }
                else
                {
                    <span>Esta reposición restaurará el saldo de tu colchón de liquidez para futuros baches de tesorería.</span>
                }
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="() => isModalOpen = false">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveMovement">Confirmar Movimiento</button>
    </Footer>
</ModalDialog>

@code {
    private bool isModalOpen = false;
    private FundMovementType selectedType = FundMovementType.RetiroPorTensionLiquidez;
    private string modalTitle = "Registrar Retiro";
    private decimal movementAmount = 0;
    private string movementReason = "";
    private DateTime movementDate = DateTime.Today;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private void OpenMovementModal(FundMovementType type)
    {
        selectedType = type;
        modalTitle = type == FundMovementType.RetiroPorTensionLiquidez 
            ? "Retiro por Tensión de Cobro" 
            : (type == FundMovementType.Reposicion ? "Reponer al Colchón" : "Aporte Extraordinario");
        
        movementReason = type == FundMovementType.RetiroPorTensionLiquidez 
            ? "Retiro temporal por retraso en cobro de factura" 
            : "Reposición tras cobrar factura pendiente";
        
        movementAmount = 0;
        movementDate = DateTime.Today;
        isModalOpen = true;
    }

    private async Task SaveMovement()
    {
        if (movementAmount <= 0) return;
        await AppState.AddFundMovementAsync(selectedType, movementAmount, movementReason);
        isModalOpen = false;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
