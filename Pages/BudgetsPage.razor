@page "/presupuestos"
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-budgets-view p-3">
    <!-- Encabezado Móvil Limpio -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h5 fw-bold text-slate-900 m-0">Presupuestos Mensuales</h1>
            <p class="text-muted fs-xs m-0">Control de consumo y techos de gasto</p>
        </div>
        <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-xs d-flex align-items-center gap-1.5" @onclick="OpenAddModal">
            <Icon Name="plus" Size="14" />
            <span>Definir Límite</span>
        </button>
    </div>

    <!-- TARJETA HERO: ESTADO GLOBAL DE PRESUPUESTO -->
    @{
        decimal totalBudgeted = AppState.Data.BudgetCategories.Sum(b => b.MonthlyLimit);
        decimal totalSpentThisMonth = AppState.Data.Expenses
            .Where(e => e.Date.Month == DateTime.Today.Month && e.Date.Year == DateTime.Today.Year)
            .Sum(e => e.UserShareAmount);
        decimal globalPercentage = totalBudgeted > 0 ? Math.Round((totalSpentThisMonth / totalBudgeted) * 100m, 1) : 0m;
        decimal globalRemaining = totalBudgeted - totalSpentThisMonth;
    }
    <div class="card hero-card-dark mb-3 overflow-hidden shadow-sm">
        <div class="card-body p-3.5">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
                <span class="fs-xs text-uppercase tracking-wider text-slate-400 fw-bold">Consumo Global del Mes</span>
                <span class="badge fs-xs rounded-pill" style="@(globalRemaining >= 0 ? "background-color: var(--pastel-success-bg); color: var(--pastel-success-text); border: 1px solid var(--pastel-success-border);" : "background-color: var(--pastel-danger-bg); color: var(--pastel-danger-text); border: 1px solid var(--pastel-danger-border);")">
                    @(globalRemaining >= 0 ? $"{globalPercentage}% consumido" : "Presupuesto excedido")
                </span>
            </div>

            <div class="d-flex align-items-baseline justify-content-between my-1">
                <div class="financial-display-amount fw-bold tracking-tight text-white">
                    @totalSpentThisMonth.ToString("N2") € <span class="fs-6 fw-normal text-slate-300">/ @totalBudgeted.ToString("N0") €</span>
                </div>
            </div>

            <!-- Barra de progreso global -->
            <div class="my-2">
                <div class="progress" style="height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.15);">
                    <div class="progress-bar @(globalPercentage > 100 ? "bg-danger" : (globalPercentage >= 80 ? "bg-warning" : "bg-light"))" 
                         role="progressbar" 
                         style="width: @Math.Min(globalPercentage, 100m)%;">
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2.5 pt-2 border-top border-slate-700 fs-xs">
                <span class="text-slate-400">
                    Margen restante: <strong class="@(globalRemaining >= 0 ? "text-emerald-400" : "text-rose-400")">@globalRemaining.ToString("N2") €</strong>
                </span>
                <span class="text-slate-400">
                    Categorías activas: <strong class="text-white">@AppState.Data.BudgetCategories.Count</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- LISTADO DE CATEGORÍAS PRESUPUESTADAS -->
    <div class="d-flex flex-column gap-2.5 mb-4">
        @if (!AppState.Data.BudgetCategories.Any())
        {
            <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3">
                <Icon Name="pie-chart" Size="28" Class="text-muted opacity-50 mb-2" />
                <div class="fw-bold text-slate-800 small">Sin presupuestos asignados</div>
                <p class="text-muted fs-xs mb-3">Fija límites en Alimentación, Ocio o Suministros para mantener a raya tus gastos.</p>
                <div>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="OpenAddModal">
                        + Añadir primer límite
                    </button>
                </div>
            </div>
        }
        else
        {
            @foreach (var budget in AppState.Data.BudgetCategories)
            {
                decimal spentInCategory = AppState.Data.Expenses
                    .Where(e => e.Category.Equals(budget.Category, StringComparison.OrdinalIgnoreCase) &&
                                e.Date.Month == DateTime.Today.Month && e.Date.Year == DateTime.Today.Year)
                    .Sum(e => e.UserShareAmount);

                decimal percentage = budget.MonthlyLimit > 0 ? Math.Round((spentInCategory / budget.MonthlyLimit) * 100m, 1) : 0m;
                bool isExceeded = spentInCategory > budget.MonthlyLimit;
                decimal remaining = budget.MonthlyLimit - spentInCategory;

                <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="category-icon-bubble">
                                    @GetCategoryIcon(budget.Category)
                                </div>
                                <div>
                                    <div class="fw-bold text-slate-900 small">@budget.Category</div>
                                    <div class="text-muted fs-xs">
                                        Gastado: <strong class="text-slate-800">@spentInCategory.ToString("N2") €</strong> de @budget.MonthlyLimit.ToString("N0") €
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-1.5">
                                <span class="badge rounded-pill fs-xs" style="@(isExceeded ? "background-color: var(--pastel-danger-bg); color: var(--pastel-danger-text); border: 1px solid var(--pastel-danger-border);" : (percentage >= 80 ? "background-color: var(--pastel-warning-bg); color: var(--pastel-warning-text); border: 1px solid var(--pastel-warning-border);" : "background-color: var(--pastel-success-bg); color: var(--pastel-success-text); border: 1px solid var(--pastel-success-border);"))">
                                    @percentage%
                                </span>
                                <button class="btn btn-sm btn-outline-secondary border-0 p-1.5 rounded-circle"
                                        @onclick="() => DeleteBudget(budget.Id)"
                                        title="Eliminar límite">
                                    <Icon Name="trash" Size="13" />
                                </button>
                            </div>
                        </div>

                        <!-- Barra de progreso de la categoría -->
                        <div class="my-2">
                            <div class="progress" style="height: 6px; border-radius: 3px; background-color: var(--color-slate-100);">
                                <div class="progress-bar @(isExceeded ? "bg-danger" : (percentage >= 80 ? "bg-warning" : "bg-dark"))" 
                                     role="progressbar" 
                                     style="width: @Math.Min(percentage, 100m)%;">
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-slate-50 fs-xs">
                            <span class="text-muted">Margen disponible:</span>
                            <strong class="@(remaining >= 0 ? "text-emerald-700" : "text-rose-700")">
                                @remaining.ToString("N2") €
                            </strong>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- MODAL DEFINIR PRESUPUESTO -->
<ModalDialog IsOpen="isModalOpen" Title="Definir Presupuesto Mensual" OnClose="CloseModal">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Categoría</label>
                <select class="form-select" @bind="newCategory">
                    <option value="Alimentación">Alimentación</option>
                    <option value="Vivienda">Vivienda</option>
                    <option value="Ocio">Ocio</option>
                    <option value="Transporte">Transporte</option>
                    <option value="Software">Software</option>
                    <option value="Material">Material</option>
                    <option value="Formación">Formación</option>
                    <option value="Equipamiento">Equipamiento</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fs-xs fw-semibold text-muted text-uppercase">Límite Máximo Mensual (€)</label>
                <input type="number" step="10" class="form-control" @bind="newLimit" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="CloseModal">Cancelar</button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="SaveBudget">Guardar Límite</button>
    </Footer>
</ModalDialog>

@code {
    private bool isModalOpen = false;
    private string newCategory = "Alimentación";
    private decimal newLimit = 400;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    private string GetCategoryIcon(string category) => category switch
    {
        "Alimentación" => "🛒",
        "Vivienda" => "🏠",
        "Ocio" => "☕",
        "Transporte" => "🚗",
        "Software" => "💻",
        "Formación" => "📚",
        "Material" => "📦",
        "Equipamiento" => "⚙️",
        _ => "📊"
    };

    private void OpenAddModal()
    {
        newCategory = "Alimentación";
        newLimit = 400;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveBudget()
    {
        if (string.IsNullOrWhiteSpace(newCategory) || newLimit <= 0) return;
        await AppState.AddOrUpdateBudgetAsync(newCategory, newLimit);
        isModalOpen = false;
    }

    private async Task DeleteBudget(string id)
    {
        await AppState.DeleteBudgetAsync(id);
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
