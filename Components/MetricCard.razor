@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Amount { get; set; } = "0,00 €";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string IconName { get; set; } = "activity";
    [Parameter] public string Variant { get; set; } = "primary"; // primary, success, warning, danger, info, indigo
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string? BadgeVariant { get; set; }
}

<div class="card metric-card shadow-sm border-0 h-100 metric-@Variant">
    <div class="card-body p-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-uppercase tracking-wider metric-title text-muted fw-semibold">@Title</span>
            <div class="metric-icon-wrap metric-icon-@Variant">
                <Icon Name="@IconName" Size="18" />
            </div>
        </div>
        <div class="d-flex align-items-baseline justify-content-between flex-wrap gap-1">
            <div class="metric-amount fw-bold">@Amount</div>
            @if (!string.IsNullOrEmpty(BadgeText))
            {
                <span class="badge @(string.IsNullOrEmpty(BadgeVariant) ? "bg-light text-dark" : $"bg-{BadgeVariant}") rounded-pill px-2 py-1 fs-xs">
                    @BadgeText
                </span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <div class="text-muted small mt-2 metric-subtitle text-truncate" title="@Subtitle">
                @Subtitle
            </div>
        }
    </div>
</div>
