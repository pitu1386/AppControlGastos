@inject AppStateService AppState
@inject SupabaseSyncService Sync
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<header class="app-mobile-header sticky-top">
    <div class="d-flex align-items-center justify-content-between px-3 py-2">
        <!-- Logo / Marca -->
        <a href="" class="d-flex align-items-center gap-2 text-decoration-none">
            <img src="icon.svg" alt="FinanzasPro" class="header-brand-img" width="32" height="32" />
            <div>
                <div class="fw-bold text-white fs-6 lh-1">FinanzasPro</div>
                <div class="fs-xs text-slate-400">Contabilidad Interna</div>
            </div>
        </a>

        <!-- Disponible Real y Acciones -->
        <div class="d-flex align-items-center gap-2">
            <div class="header-available-pill" title="Dinero Propio Realmente Disponible">
                <span class="fs-xs text-slate-300 me-1">Disp:</span>
                <span class="fw-bold @(AppState.Data.RealAvailableCash >= 0 ? "text-emerald-400" : "text-rose-400")">
                    @AppState.Data.RealAvailableCash.ToString("N0") €
                </span>
            </div>

            @if (canInstall)
            {
                <button class="btn btn-xs btn-primary rounded-pill px-2 py-1 fs-xs d-flex align-items-center gap-1 shadow-xs" @onclick="InstallPwa" title="Instalar en tu móvil o PC">
                    <Icon Name="download" Size="13" />
                    <span>Instalar</span>
                </button>
            }

            <a href="configuracion" class="header-icon-btn text-slate-200" title="Estado de Supabase (@(Sync.State == SyncState.Synced ? "Sincronizado" : "Local / Nube"))">
                <span class="fs-xs">@(Sync.State == SyncState.Synced ? "☁️" : "☁️")</span>
            </a>

            <a href="menu" class="header-icon-btn text-slate-200" title="Ver todos los módulos">
                <Icon Name="settings" Size="18" />
            </a>
        </div>
    </div>
</header>

<style>
    .app-mobile-header {
        background-color: #0f172a;
        border-bottom: 1px solid #1e293b;
        z-index: 1030;
    }
    .header-brand-img {
        border-radius: 8px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
        flex-shrink: 0;
    }
    .header-available-pill {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 20px;
        padding: 4px 10px;
        font-size: 0.8rem;
    }
    .text-emerald-400 { color: #6ee7b7 !important; } /* Menta pastel suave */
    .text-rose-400 { color: #fca5a5 !important; } /* Rosa pastel suave */
    .header-icon-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background-color: #1e293b;
        border: 1px solid #334155;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: background 0.15s ease;
    }
    .header-icon-btn:hover {
        background-color: #334155;
    }
</style>

@code {
    private bool canInstall = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
        Sync.OnSyncStatusChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                canInstall = await JS.InvokeAsync<bool>("financialApp.isInstallable");
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task InstallPwa()
    {
        await JS.InvokeVoidAsync("financialApp.promptInstall");
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        Sync.OnSyncStatusChanged -= StateHasChanged;
    }
}
