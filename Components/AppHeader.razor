@inject AppStateService AppState
@inject SupabaseSyncService Sync
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<header class="app-mobile-header">
    <div class="d-flex align-items-center justify-content-between px-3 py-2">
        <!-- Logo / Marca -->
        <a href="" class="d-flex align-items-center gap-2 text-decoration-none text-truncate me-2">
            <span class="header-brand-badge flex-shrink-0">€</span>
            <div class="text-truncate">
                <div class="fw-bold text-white fs-6 lh-1 text-truncate">FinanzasPro</div>
                <div class="fs-xs text-slate-400 text-truncate">Autónomo</div>
            </div>
        </a>

        <!-- Disponible Real y Acciones -->
        <div class="d-flex align-items-center gap-1 gap-sm-2 flex-shrink-0">
            <div class="header-available-pill" title="Dinero Propio Realmente Disponible">
                <span class="fs-xs text-slate-400 me-1">Disp:</span>
                <span class="fw-bold fs-xs @(AppState.Data.RealAvailableCash >= 0 ? "text-emerald-400" : "text-rose-400")">
                    @AppState.Data.RealAvailableCash.ToString("N0") €
                </span>
            </div>

            @if (canInstall)
            {
                <button class="header-icon-btn text-emerald-400" @onclick="InstallPwa" title="Instalar en tu móvil o PC">
                    <Icon Name="download" Size="16" />
                </button>
            }

            <a href="configuracion" class="header-icon-btn text-slate-200" title="Estado de Supabase">
                <span class="fs-xs">@(Sync.State == SyncState.Synced ? "🟢" : "☁️")</span>
            </a>

            <a href="menu" class="header-icon-btn text-slate-200" title="Ver todos los módulos">
                <Icon Name="settings" Size="18" />
            </a>
        </div>
    </div>
</header>

<style>
    .app-mobile-header {
        background-color: #0f172a;
        border-bottom: 1px solid #1e293b;
        z-index: 1030;
        flex-shrink: 0;
        padding-top: max(env(safe-area-inset-top, 0px), 4px);
        padding-left: env(safe-area-inset-left, 0px);
        padding-right: env(safe-area-inset-right, 0px);
    }
    .header-brand-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        font-weight: 800;
        border-radius: 9px;
        font-size: 0.95rem;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
    }
    .header-available-pill {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 16px;
        padding: 4px 8px;
        font-size: 0.78rem;
        white-space: nowrap;
    }
    .text-emerald-400 { color: #34d399 !important; }
    .text-rose-400 { color: #fb7185 !important; }
    .header-icon-btn {
        width: 36px;
        height: 36px;
        min-width: 36px;
        min-height: 36px;
        border-radius: 50%;
        background-color: #1e293b;
        border: 1px solid #334155;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: background 0.15s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .header-icon-btn:active {
        background-color: #334155;
    }
    .header-icon-btn:hover {
        background-color: #334155;
    }
</style>

@code {
    private bool canInstall = false;

    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
        Sync.OnSyncStatusChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                canInstall = await JS.InvokeAsync<bool>("financialApp.isInstallable");
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task InstallPwa()
    {
        await JS.InvokeVoidAsync("financialApp.promptInstall");
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        Sync.OnSyncStatusChanged -= StateHasChanged;
    }
}
