                <Icon Name="chart" Size="20" />
            </div>
            <span class="nav-tab-label">Inicio</span>
        </NavLink>

        <NavLink class="nav-tab" href="facturas">
            <div class="nav-tab-icon">
                <Icon Name="invoice" Size="20" />
            </div>
            <span class="nav-tab-label">Facturas</span>
        </NavLink>

        <NavLink class="nav-tab" href="gastos">
            <div class="nav-tab-icon">
                <Icon Name="expense" Size="20" />
            </div>
            <span class="nav-tab-label">Gastos</span>
        </NavLink>

        <NavLink class="nav-tab" href="gastos-compartidos">
            <div class="nav-tab-icon">
                <Icon Name="users" Size="20" />
