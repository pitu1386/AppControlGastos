@inherits LayoutComponentBase
@inject AppStateService AppState
@implements IDisposable

<div class="mobile-viewport-wrapper">
    <div class="mobile-device-frame">
        <!-- Barra Superior Móvil -->
        <AppHeader />

        <!-- Contenido Central con Scroll Móvil -->
        <main class="mobile-body-content">
            @if (!AppState.IsInitialized)
            {
                <div class="d-flex flex-column justify-content-center align-items-center py-5 my-5">
                    <div class="spinner-border text-emerald-500" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <span class="small text-muted mt-3">Iniciando contabilidad interna...</span>
                </div>
            }
            else
            {
                @Body
            }
        </main>

        <!-- Barra Inferior de Pestañas Móvil -->
        <BottomNav />
    </div>
</div>

<style>
    /* Contenedor Exterior que ocupa el 100% exacto de la pantalla dinámica */
    .mobile-viewport-wrapper {
        width: 100%;
        height: 100%;
        height: 100dvh;
        max-height: 100dvh;
        background-color: #0b1329;
        display: flex;
        justify-content: center;
        align-items: stretch;
        overflow: hidden;
        padding: 0;
    }

    /* Marco del Smartphone: Flex Column con Altura Confinada */
    .mobile-device-frame {
        width: 100%;
        max-width: 500px;
        height: 100%;
        height: 100dvh;
        max-height: 100dvh;
        background-color: #f8fafc;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45);
    }

    /* Área central de desplazamiento interno */
    .mobile-body-content {
        flex: 1 1 0%;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-y: contain;
        padding-bottom: 24px;
    }

    /* Simulación de Marco Móvil en Escritorio (Pantallas > 576px) */
    @@media (min-width: 576px) {
        .mobile-viewport-wrapper {
            padding: 24px 0;
            align-items: center;
            background: radial-gradient(circle at 50% 20%, #1e293b 0%, #0b1329 100%);
        }
        .mobile-device-frame {
            height: calc(100vh - 48px);
            height: calc(100dvh - 48px);
            max-height: 920px;
            border-radius: 36px;
            border: 8px solid #1e293b;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7);
        }
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await AppState.InitializeAsync();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
